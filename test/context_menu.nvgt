#include "../form/form.nvgt"

void main() {
	nv_form f;
	f.create_window("Context Menu Test", say_dialog = true);
	nv_form_button@ btn = f.add_button("Button with Menu", "btn1");
	@btn.menu = nv_form_context_menu(f, btn);
	btn.menu.add_item("Option 1", on_option);
	btn.menu.add_item("Option 2", on_option);
	btn.menu.add_item("Option3", "op3", on_option);
	nv_form_input@ inp = f.add_input("Input with Menu", "inp1");
	@inp.menu = nv_form_context_menu(f, inp);
	inp.menu.add_item("Clear Text", on_clear);
	inp.menu.add_item("Say Hello", on_hello);
	nv_form_list_box@ lst = f.add_list("List with context menu", "list");
	lst.add("A", "a");
	lst.add("B", "b");
	@lst.menu = nv_form_context_menu(f, lst, callback = on_lst_call);
	lst.menu.add_item("Inspect", "i");
	lst.menu.add_item("Copy item name", "c");
	nv_form_button@ close_btn = f.add_button("Close", "close", cancel = true);
	@close_btn.shortcut = nv_shortcut(KEY_C, alt = true);
	wait(250);
	speak("Context menu test loaded. Press Shift+F10 or the Application key on the button or input to open their context menus.");
	while (f.monitor()) {
		wait(5);
	}
}
bool on_option(nv_form_context_menu@ cm) {
	alert("Context Menu", "You selected an option from the menu attached to: " + cm.ctrl.caption + ". It is: " + cm.list.focused_item.id);
	return true;
}
bool on_clear(nv_form_context_menu@ cm) {
	nv_form_input@ inp = cast<nv_form_input@>(cm.ctrl);
	if (@inp != null) {
		inp.text = "";
		inp.cursor = 0;
		speak("Text cleared");
	}
	return true;
}
bool on_hello(nv_form_context_menu@ cm) {
	speak("Hello from the context menu!");
	return true;
}
bool on_lst_call(nv_form_context_menu@ ctx) {
	string sl = ctx.list.focused_item_id;
	if (sl == "") return false;
	nv_form_list_box@ ctrl = cast<nv_form_list_box@>(ctx.ctrl);
	if (@ctrl == null) return false; // Invalid control.
	if (ctrl.focused_item_id == "") {
		speak("Select an item first");
		return false;
	}
	if (sl == "i") {
		alert("Info", "Current position is " + ctrl.list_position + ", selected ID is " + ctrl.focused_item_id);
		return true;
	} else if (sl == "c") {
		clipboard_set_text(ctrl.focused_item_id);
		speak("Copied");
		return true;
	}
	return true;
}
