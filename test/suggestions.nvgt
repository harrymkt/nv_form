#include "../form/form.nvgt"

void main() {
	nv_form f;
	f.create_window("Auto-complete Test", say_dialog = true);
	nv_form_input@ inp = f.add_input("Country", "country");
	@inp.suggestion_manager = nv_form_suggestion_manager(f, inp);
	inp.suggestion_manager.add_suggestions({"Afghanistan", "Albania", "Algeria", "Andorra", "Angola", "Argentina", "Armenia", "Australia", "Austria", "Azerbaijan", "Bahamas", "Bahrain", "Bangladesh", "Barbados", "Belarus", "Belgium", "Belize", "Benin", "Bhutan", "Bolivia", "Brazil", "Bulgaria", "Canada", "Chile", "China", "Colombia"});
	nv_form_button@ close_btn = f.add_button("Close", "close", cancel = true);
	@close_btn.shortcut = nv_shortcut(KEY_C, alt = true);
	speak("Auto-complete test loaded. Type the first few letters of a country (e.g., 'B' or 'Can'). Use Up and Down to browse suggestions, and Enter or Tab to select.");

	while (f.monitor()) {
		wait(5);
	}
}
