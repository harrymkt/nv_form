#pragma include ".."
#include "form/form.nvgt"
uint fclcount = 0;
void main() {
	nv_form f;
	f.create_window("Input Event Test");
	nv_form_input@ a = f.add_input("Type text here", "inp", multiline = true);
	a.event.add(input_event); // funcdef handler.
	nv_form_button@ b = f.add_button("Close", "close", false, true);
	f.controls[0].focus(false, false); // Not quiet, not interrupt.
	while (f.monitor()) {
		wait(5);
	}
	alert("Information", (a.text != "" ? "You typed: " + a.text : "You did not type anything"));
	alert("Information", (fclcount > 0 ? "You lost focus from the input " + fclcount + " times" : "You did not lose focus from the input control"));
}
void input_event(nv_form_event@ event) {
	if (event.type == NV_FORM_EVENT_FOCUS_GAINED) {
		selectinput(event);
		return;
	} else if (event.type == NV_FORM_EVENT_FOCUS_LOST) {
		fclcount ++;
		return;
	}
	if (event.type != NV_FORM_EVENT_INPUT) return;
	nv_form_input_event@ e = cast<nv_form_input_event@>(event);
	if (@e == null) return;
	if (e.deleted) {
		string s = "keyboard/delete.ogg";
		// Play the sound
		return;
	}
	string k = "type_key";
	string c = e.character;
	if (c == " ") k = "space";
	else if (c == "\n") k = "return";
	string s = "keyboard/" + k + ".ogg";
	// Play the sound
}
void selectinput(nv_form_event@ e) {
	if (e.type != NV_FORM_EVENT_FOCUS_GAINED) return;
	nv_form_input@ c = cast<nv_form_input@>(e.ctrl);
	if (@c == null) return; // Invalid
	c.select(0);
}
