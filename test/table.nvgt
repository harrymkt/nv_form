#include "../form/form.nvgt"
void main() {
	nv_form f;
	f.create_window("Table View Test", say_dialog = true);
	nv_form_table@ table = f.add_table("High Scores", "table1", speak_position = true);
	table.set_headers({"Rank", "Player", "Score", "Level"});
	table.add_row({"1", "Alice", "10000", "50"}, "row1");
	table.add_row({"2", "Bob", "8500", "42"}, "row2");
	table.add_row({"3", "Charlie", "12000", "55"}, "row3"); // Out of order for sorting test
	table.add_row({"4", "David", "5000", "20"}, "row4");
	table.add_row({"5", "Eve", "9200", "48"}, "row5");
	f.add_button("Close", "close", cancel = true);
	wait(250);
	speak("Table test loaded. Use Up/Down to navigate rows, Left/Right for columns. Press H for header, R for whole row, and S to sort by current column.");
	while (f.monitor()) {
		wait(5);
	}
}
