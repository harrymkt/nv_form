#pragma include ".."
#include "form/form.nvgt"
void main() {
	nv_form f;
	f.create_window("Treeview Test");
	nv_form_treeview@ a = nv_form_treeview(f, "Directories", "dir");
	@a.shortcut = nv_shortcut(KEY_D, alt = true);
	nv_form_tree_node@ b = a.add("C:", "C:");
	string[] list = {"Program files", "Program files (x86)", "Users", "Windows"};
	for (uint i = 0; i < list.length(); i++) b.add(list[i], list[i]);
	nv_form_tree_node@ c = a.add("D:", "D:");
	list = {"Audio", "Documents", "Downloads", "Music"};
	for (uint i = 0; i < list.length(); i++) c.add(list[i], list[i]);
	nv_form_tree_node@ cc = c.add("Tools", "tools");
	cc.add("Android", "android");
	cc.add("PC", "PC");
	list = {"Home", "Desktop", "Network"};
	for (uint i = 0; i < list.length(); i++) a.add(list[i], list[i]);
	f.add_control(a);
	nv_form_treeview@ m = f.add_treeview("Files", "file", multiselect = true);
	m.add("Program.exe", "program");
	m.add("Tools", "tools").add("Application", "application.exe");
	nv_form_button@ can = f.add_button("Close", "close", false, true);
	while (f.monitor()) {
		wait(5);
	}
	string[] fr = selected_nodes(m.nodes);
	if (fr.length() > 0) alert("Selected files", join(fr, ", "));
	if (@a.focused_node != null) alert("The selected directory is", a.focused_node.full_id("/"));
}
string[] selected_nodes(nv_form_tree_node@[] nodes) {
	if (nodes.length() < 1) return {};
	string[] fr;
	foreach (nv_form_tree_node@ node: nodes) {
		if (node.selected) fr.insert_last(node.full_id("/"));
		if (node.has_nodes) fr.extend(selected_nodes(node.nodes));
	}
	return fr;
}
