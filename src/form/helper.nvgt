// Other miscellaneous functions and classes.
shared int nv_string_contains(const string &in str, const string &in search, int occurance = 1) {
	uint c = 0;
	int pos = -1;
	while (c < occurance) {
		pos = str.find_first(search, pos + 1);
		if (pos > -1)
			c++;
		else
			break;
	}
	return c == occurance ? pos : -1;
}
// Wrapper functions for keyboard echo changing.
shared int nvform_change_keyboard_echo(int keyboard_echo, int dir = 1) {
	keyboard_echo += dir;
	if (keyboard_echo < TEXTFLAG_ENTRY_NONE) keyboard_echo = TEXTFLAG_ENTRY_CHARACTERS_WORDS;
	else if (keyboard_echo > TEXTFLAG_ENTRY_CHARACTERS_WORDS) keyboard_echo = TEXTFLAG_ENTRY_NONE;
	return keyboard_echo;
}
shared string nvform_keyboard_echo_string(int keyboard_echo) {
	if (keyboard_echo == TEXTFLAG_ENTRY_CHARACTERS) return "characters";
	else if (keyboard_echo == TEXTFLAG_ENTRY_WORDS) return "words";
	else if (keyboard_echo == TEXTFLAG_ENTRY_CHARACTERS_WORDS) return "characters and words";
	else return "none";
}
string nv_get_readable_key(const string &in symbol, bool strict = false) {
	string[][] map = {
		{";", "Semicolon"},
		{":", "Colon"},
		{",", "Comma"},
		{".", "Period"},
		{"!", "Bang"},
		{"?", "Question"},
		{"'", "Apostrophe"},
		{"\"", "Quote"},
		{"(", "Left Parenthesis"},
		{")", "Right Parenthesis"},
		{"[", "Left Bracket"},
		{"]", "Right Bracket"},
		{"{", "Left Brace"},
		{"}", "Right Brace"},
		{"<", "Less"},
		{">", "Greater"},
		{"/", "Slash"},
		{"\\", "Backslash"},
		{"|", "Bar"},
		{"-", "Dash"},
		{"_", "Underscore"},
		{"+", "Plus"},
		{"=", "Equals"},
		{"*", "Star"},
		{"&", "Ampersand"},
		{"^", "Caret"},
		{"%", "Percent"},
		{"$", "Dollar"},
		{"#", "Number"},
		{"@", "At"},
		{"`", "Graav"},
		{"~", "Tilda"}
	};
	for (uint i = 0; i < map.length(); i++) {
		if (map[i][0] == symbol)
			return map[i][1];
	}
	return (strict ? "" : symbol);
}
string nv_read_shortcut(const string &in shortcut) {
	string f = shortcut;
	int r = shortcut.rfind("+");
	if (r > -1) {
		f = shortcut.substr(0, r);
		string g = shortcut.substr(r + 1);
		g = nv_get_readable_key(g);
		f += "+" + g;
	} else f = nv_get_readable_key(f);
	return f;
}
nv_shortcut@ parse_nv_shortcut(const string &in value) {
	string[] lines = value.lower().split("+");
	if (lines.length() < 1) return null;
	uint taps = 1;
	string f = lines[lines.length() - 1];
	string[] tap_split = f.split("*");
	if (tap_split.length() == 2) {
		f = tap_split[0];
		taps = parse_int(tap_split[1]);
	}
	bool ctrl = lines.find("ctrl") > -1, shift = lines.find("shift") > -1, alt = lines.find("alt") > -1;
	int k = get_key_code(f);
	return nv_shortcut(k, ctrl, shift, alt, taps);
}
class nv_shortcut {
	int key;
	bool ctrl, shift, alt;
	uint tap;
	uint current_taps = 0;
	timer tap_timer;
	int tap_timeout = 300;
	string custom_name = "";
	nv_shortcut(int k, bool ctrl = false, bool shift = false, bool alt = false, uint tap = 1) {
		this.key = k;
		this.ctrl = ctrl;
		this.shift = shift;
		this.alt = alt;
		this.tap = tap;
		tap_timer.restart();
	}
	string get_name() const property {
		string[] f;
		if (ctrl) f.insert_last("Ctrl");
		if (shift) f.insert_last("Shift");
		if (alt) f.insert_last("Alt");
		if (key != KEY_UNKNOWN) f.insert_last(get_key_name(key));
		string result = nv_read_shortcut(join(f, "+")).trim_whitespace();
		string ex = tapname.trim_whitespace();
		if (ex != "") result.insert(0, ex + " ");
		return result;
	}
	string get_tapname() const property {
		if (tap <= 1) return "";
		string[] taps = {"Double tap", "Triple tap"};
		int pos = tap - 2;
		if (pos >= 0 && pos < taps.length()) return taps[pos];
		return tap + " taps";
	}
	bool modifiers_match(bool c, bool s, bool a) const {
		return (ctrl == c && shift == s && alt == a);
	}
}
class nv_shortcut_manager : engine_key_event_listener {
	nv_shortcut@[] shortcuts;
	int last_key = -1;
	uint tap_count = 0;
	timer tap_timer;
	int tap_timeout = 200;
	// Captured modifier state at time of press
	bool last_ctrl, last_shift, last_alt;
	bool force_resolved = false;
	nv_shortcut_manager() {
		::on_key_press += this;
	}
	~nv_shortcut_manager() {
		::on_key_press -= this;
	}
	void add(nv_shortcut@ s) {
		if (@s != null) shortcuts.insert_last(s);
	}
	void on_key_press(int key) {
		bool c = key_down(KEY_LCTRL) || key_down(KEY_RCTRL);
		bool s = key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT);
		bool a = key_down(KEY_LALT) || key_down(KEY_RALT);
		if (key == last_key && tap_timer.elapsed < tap_timeout && c == last_ctrl && s == last_shift && a == last_alt) {
			tap_count++;
		} else {
			tap_count = 1;
			last_key = key;
			last_ctrl = c;
			last_shift = s;
			last_alt = a;
		}
		tap_timer.restart();
		force_resolved = !has_higher_tap(last_key, tap_count, last_ctrl, last_shift, last_alt);
	}
	bool is_pressed(nv_shortcut@ s) {
		if (@s == null || last_key == -1) return false;
		if (s.key != last_key || s.tap != tap_count) return false;
		// Ensure modifiers match what was held when the key was physically pressed
		if (!s.modifiers_match(last_ctrl, last_shift, last_alt)) return false;
		// Ready if no more taps possible or timeout reached
		bool ready = force_resolved || (tap_timer.elapsed >= tap_timeout);
		return ready;
	}
	nv_shortcut@ get_pressed() property {
		if (last_key == -1) return null;
		bool ready = force_resolved || (tap_timer.elapsed >= tap_timeout);
		if (ready) {
			for (uint i = 0; i < shortcuts.length(); i++) {
				if (is_pressed(shortcuts[i])) {
					nv_shortcut@ s = shortcuts[i];
					consume();
					return s;
				}
			}
			consume();
		}
		return null;
	}
	void consume() {
		last_key = -1;
		tap_count = 0;
		force_resolved = false;
	}
	private bool has_higher_tap(int k, uint t, bool c, bool s, bool a) {
		for (uint i = 0; i < shortcuts.length(); i++) {
			if (shortcuts[i].key == k && shortcuts[i].tap > t && shortcuts[i].modifiers_match(c, s, a))
				return true;
		}
		return false;
	}
}
