#include "utils/*.nvgt"
string get_nv_form_control_type_string(int ct) {
	switch (ct) {
		case NV_FORM_CT_BUTTON: return "button";
		case NV_FORM_CT_INPUT: return "edit";
		case NV_FORM_CT_SPIN: return "spin edit";
		case NV_FORM_CT_CHECKBOX: return "check box";
		case NV_FORM_CT_PROGRESS: return "progress bar";
		case NV_FORM_CT_LIST: return "list";
		case NV_FORM_CT_SLIDER: return "slider";
		case NV_FORM_CT_KEYBOARD_AREA: return "keyboard area";
		case NV_FORM_CT_LINK: return "link";
		case NV_FORM_CT_SWITCH: return "switch";
		case NV_FORM_CT_TAB_CONTROL: return "Tab control";
		case NV_FORM_CT_TREEVIEW: return "tree view";
		case NV_FORM_CT_TABLE: return "table";
		default: return "";
	}
}
interface nv_utility_form {
	void monitor();
}
class nv_go_to_index : nv_utility_form {
	nv_form@ parent;
	nv_form_control@ ctrl;
	nv_form f;
	nv_form_input@ f_index, f_col;
	nv_form_button@ f_ok, f_cancel;
	nv_go_to_index(nv_form@ parent, nv_form_control@ control) {
		@this.parent = @parent;
		@ctrl = @control;
		nv_form_input@ ctrl_input = cast < nv_form_input@ > (ctrl);
		nv_form_list_box@ ctrl_list = cast < nv_form_list_box@ > (ctrl);
		nv_form_treeview@ ctrl_tree = cast < nv_form_treeview@ > (ctrl);
		if (@ctrl_list == null && @ctrl_input == null && @ctrl_tree == null) return;
		else if (
			(@ctrl_input != null && ctrl_input.text == "") ||
			(@ctrl_list != null && ctrl_list.items.length() < 1) ||
			(@ctrl_tree != null && ctrl_tree.visible_nodes.length() < 1)
		) return;
		int current = 1;
		string wmsg = "Go to line";
		string lnmsg = "Line number";
		if (@ctrl_input != null) current = ctrl_input.get_line_number();
		else if (@ctrl_list != null || @ctrl_tree != null) {
			current = (@ctrl_list != null ? ctrl_list.list_position : ctrl_tree.pos) + 1;
			wmsg = "Go to index";
			lnmsg = "Item number";
		}
		f.create_window(wmsg, false, true);
		@f_index = nv_form_input(f, lnmsg, "ln");
		f_index.default_text = current;
		f_index.select(0);
		f_index.enable_go_line = false;
		f_index.enable_search = false;
		f.add_control(f_index);
		nv_form_control@ index_to_focus = f_index;
		if (@ctrl_input != null) {
			@f_col = nv_form_input(f, "Line column", "lc");
			f_col.default_text = ctrl_input.get_line_column();
			f_col.select(0);
			f_col.enable_go_line = false;
			f_col.enable_search = false;
			f.add_control(f_col);
			if (!ctrl_input.multiline) {
				@index_to_focus = f_col;
				f_index.hide();
			}
		}
		@f_ok = f.add_button("Ok", "ok", true);
		@f_cancel = f.add_button("Cancel", "cancel", false, true);
		@f.background_callback = parent.background_callback;
		f.focus_control(index_to_focus, false, false);
		@parent.nv_utility_form = this;
	}
	void monitor() {
		if (!f.monitor()) {
			parent.focus_control(ctrl);
			@parent.nv_utility_form = null;
			return;
		}
		nv_form_input@ ctrl_input = cast < nv_form_input@ > (ctrl);
		nv_form_list_box@ ctrl_list = cast < nv_form_list_box@ > (ctrl);
		nv_form_treeview@ ctrl_tree = cast < nv_form_treeview@ > (ctrl);
		if (f.is_pressed(f_cancel)) {
			parent.focus_control(ctrl);
			@parent.nv_utility_form = null;
			return;
		} else if (f.is_pressed(f_ok)) {
			string idx = f_index.text;
			if (!idx.is_digits() or idx.substr(0, 1) == "0") {
				speak("enter a positive number");
				f.focus_control(f_index, false, false);
				return;
			}
			if (@ctrl_list != null) {
				if (!ctrl_list.set_pos(parse_int(idx) - 1, false)) {
					speak("Invalid item number");
					f.focus_control(f_index, false, false);
					return;
				}
				@parent.nv_utility_form = null;
				parent.focus_control(ctrl);
				return;
			} else if (@ctrl_tree != null) {
				if (!ctrl_tree.set_pos(parse_int(idx) - 1, false)) {
					speak("Invalid item number");
					f.focus_control(f_index, false, false);
					return;
				}
				@parent.nv_utility_form = null;
				parent.focus_control(ctrl);
				return;
			}
			string col = f_col.text;
			if (!col.is_digits()) {
				speak("enter a positive number");
				f.focus_control(f_col, false, false);
				return;
			}
			if (!ctrl_input.set_line(parse_int(idx), parse_int(col))) {
				speak("invalid line number!");
				f.focus_control(f_index, false, false);
			} else {
				@parent.nv_utility_form = null;
				parent.focus_control(ctrl);
			}
		}
		return ;
	}
}
class nv_search_for : nv_utility_form {
	nv_form@ parent;
	nv_form_control@ ctrl;
	nv_form f;
	nv_form_input@ f_text;
	nv_form_button@ f_next, f_prev, f_cancel;
	nv_search_for(nv_form@ parent, nv_form_control@ control) {
		@this.parent = @parent;
		@ctrl = @control;
		nv_form_input@ ctrl_input = cast < nv_form_input@ > (ctrl);
		nv_form_list_box@ ctrl_list = cast < nv_form_list_box@ > (ctrl);
		nv_form_treeview@ ctrl_tree = cast < nv_form_treeview@ > (ctrl);
		if (@ctrl_list == null && @ctrl_input == null && @ctrl_tree == null) return;
		else if (
			(@ctrl_input != null && ctrl_input.text == "") ||
			(@ctrl_list != null && ctrl_list.items.length() < 1) ||
			(@ctrl_tree != null && ctrl_tree.visible_nodes.length() < 1)
		) return;
		string current = "";
		if (parent.nv_utility_form_data.exists("last_search")) parent.nv_utility_form_data.get("last_search", current);
		string wmsg = "Search for text";
		string lnmsg = "Text to search";
		if (@ctrl_list != null || @ctrl_tree != null)
			wmsg = "Search for item";
		f.create_window(wmsg, false, true);
		@f_text = f.add_input(lnmsg, "ln", current, "", 256);
		f_text.select(0);
		f_text.enable_go_line = false;
		f_text.enable_search = false;
		@f_next = f.add_button("find next", "next", true);
		@f_next.shortcut = nv_shortcut(KEY_N, alt = true);
		@f_prev = f.add_button("find previous", "prev");
		@f_prev.shortcut = nv_shortcut(KEY_P, alt = true);
		@f_cancel = f.add_button("cancel", "cancel", false, true);
		@f.background_callback = parent.background_callback;
		f.focus_control(f_text, false, false);
		@parent.nv_utility_form = this;
	}
	void monitor() {
		if (!f.monitor()) {
			parent.focus_control(ctrl);
			@parent.nv_utility_form = null;
			return;
		}
		bool nv_search_forward = f.is_pressed(f_next);
		if (f.is_pressed(f_cancel)) {
			parent.focus_control(ctrl);
			@parent.nv_utility_form = null;
			return;
		} else if (nv_search_forward or f.is_pressed(f_prev)) {
			string text = f_text.text;
			if (text == "") {
				speak("enter some text to search for");
				f.focus_control(f_text, false, false);
				return;
			}
			if (!parent.search(ctrl, text, nv_search_forward ? 1 : -1)) {
				speak("nothing found");
				f.focus_control(f_text, false, false);
			} else {
				@parent.nv_utility_form = null;
				parent.nv_utility_form_data.set("last_search", text);
			}
			return;
		}
	}
}
bool handle_nv_utils(nv_form_control@ ctrl) {
	if (@ctrl == null) return false;
	int[] supported_types = {NV_FORM_CT_LIST, NV_FORM_CT_INPUT, NV_FORM_CT_TREEVIEW};
	if (supported_types.find(ctrl.type) < 0) return false;
	nv_form_input@ inp = cast < nv_form_input@ > (ctrl);
	if (@inp != null && inp.password_mask != "") return false;
	if ((keyboard_modifiers & KEYMOD_CTRL) != 0 && key_pressed(KEY_G) && ctrl.enable_go_line) {
		nv_go_to_index(ctrl.parent, ctrl);
		return true;
	} else if ((keyboard_modifiers & KEYMOD_CTRL) != 0 && key_pressed(KEY_F) && ctrl.enable_search) {
		nv_search_for(ctrl.parent, ctrl);
		return true;
	} else if (key_repeating(KEY_F3)) {
		string last_search = "";
		if (ctrl.parent.nv_utility_form_data.get("last_search", last_search))
			ctrl.parent.search(ctrl, last_search, (keyboard_modifiers & KEYMOD_SHIFT) == 0 ? 1 : -1, false);
		else
			nv_search_for(ctrl.parent, ctrl);
		return true;
	}
	return false;
}
