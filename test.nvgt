#include "form/form.nvgt"
class custom_button: nv_form_button {
	custom_button(nv_form@parent) {
		super(@parent, "press this now", "click");
	}
	void on_fire() {
		alert("ok", "it works: " + pressed);
	}
}
void main() {
	int profile = question("Profiler", "Would you like to run the profile during this test?");
	if (profile == 1) start_profiling();
	nv_form f;
	f.create_window("Test", say_dialog = true);
	wait(150);
	custom_button my_button(f);
	@my_button.shortcut = nv_shortcut(KEY_P, alt = true);
	my_button.autoactivate = true;
	f.add_control(my_button);
	nv_form_input@ inp = nv_form_input(f, "Type text", "type1");
	inp.multiline = true;
	@inp.shortcut = nv_shortcut(KEY_E, false, false, true);
	f.add_control(inp);
	nv_form_input@ inp2 = nv_form_input(f, "Type password", "type2");
	inp2.password_mask = "*";
	@inp2.shortcut = nv_shortcut(KEY_E, true, false, false);
	inp2.set_disallowed_chars("/'\\\" ", false, "Invalid character");
	f.add_control(inp2);
	nv_form_input@ inp3 = f.add_input("Type 8 numbers", "8num", "", "", 8);
	inp3.set_disallowed_chars("0123456789", true, "Numbers only");
	nv_form_spin@ spin = nv_form_spin(f, "Milliseconds for a double press", "msdp");
	f.add_control(spin);
	nv_form_checkbox@ rvd = f.add_checkbox("Reverb's dry field is enabled", "rvd", true);
	nv_form_spin@ spin2 = nv_form_spin(f, "Reverb's dry value", "rvd");
	spin2.step = 0.25;
	spin2.min = 0.0;
	spin2.max = 1.0;
	f.add_control(spin2);
	nv_form_input@ rinp = nv_form_input(f, "Notes", "note");
	rinp.read_only = true;
	rinp.multiline = true;
	@rinp.shortcut = nv_shortcut(KEY_N, true);
	rinp.default_text = "1. Thank you for trying NV Form.\n2. This is testing box";
	rinp.select(0);
	rinp.event.add(selectinput);
	f.add_control(rinp);
	nv_form_switch@ enable = f.add_switch("Enable the next button", "enable");
	enable.add("On", "1");
	enable.add("Off", "0");
	enable.set_pos(enable.get_item_index("1"));
	@enable.shortcut = parse_nv_shortcut("Alt+S");
	nv_form_button@ btne = f.add_button("Subscribe", "sub");
	@btne.shortcut = nv_shortcut(KEY_S, alt = true, tap = 2);
	//now we create a basic button with a callback registered to it.
	nv_form_button@btn = f.add_button("Press this other button here", "testbtn", cancel = true, callback = on_x_click);
	btn.hide();
	//now we create a legacy style button, setting it as the primary control.
	nv_form_button@ spt = f.add_button("Speak something", "speak", primary = true);
	@spt.shortcut = nv_shortcut(KEY_S, alt = true);
	spt.autoactivate = true;
	@f.add_checkbox("Uncheck this", "box", true).shortcut = nv_shortcut(KEY_C, alt = true);
	nv_form_list_box@lst = nv_form_list_box(f, "test items", "items", speak_position = true);
	lst.add_items({"This is a test item", "another item", "nvgt", "cpp"});
	f.add_control(lst);
	nv_form_list_box@ mlst = f.add_list("Files (multiselect)", "mls", multiselect = true);
	mlst.add_items({"document.txt", "readme.md", "program.exe", "python.py", "test.c", "test.h"});
	@mlst.shortcut = nv_shortcut(KEY_F, alt = true);
	nv_form_list_box@lst_c = nv_form_list_box(f, "Custom test items", "items2");
	lst_c.custom_type = "Combo box";
	lst_c.add_items({"NVGT", "CPP", "HTML", "JS", "CSS"});
	f.add_control(lst_c);
	nv_form_slider@slider = f.add_slider("volume level", "vol", max_value = 100, page_size = 5);
	nv_form_keyboard_area@ kbd = f.add_keyboard_area("have fun here", "kbd");
	@kbd.shortcut = nv_shortcut(KEY_G, alt = true);
	nv_form_progress_bar@progress = nv_form_progress_bar(f, "downloading file", "progress");
	progress.speak_progress_updates = false;
	f.add_control(@progress, position = 6);
	nv_form_link@ link = f.add_link("Open NVGT Website", "https://nvgt.dev", "nvgtweb");
	f.controls[1].focus(false, false);
	while (true) {
		if (!f.monitor()) {
			alert("ok", "time to exit this application");
			break;
		}
		spin2.read_only = !rvd.state;
		nv_form_control@ ctrl = f.current_control;
		if (@ctrl != null && ctrl.id == "kbd") keyboard_loop();
		nv_form_switch_item@ enabled = f.get_switch_focus(enable);
		btne.enabled = enabled.id == "1";
		if (f.is_pressed("speak")) {
			speak("Legacy buttons work!", false);
			nv_form_list_item@focused_item = f.get_list_focus("items");
			if (@focused_item == null) speak("Nothing selected", false);
			else speak(focused_item.text + " selected", false);
			speak("Checkbox is " + (f.is_checked("box") ? "checked" : "unchecked"), false);
			if (progress.value != 100) {
				double r = random(5.0, 10.0);
				r += progress.value;
				for (double start = progress.value; start < r; start += 1) {
					progress.value = start;
					wait(random(50, 300));
				}
			}
			if (@enabled != null) speak("Enable button is set to " + enabled.text + ", which is " + enabled.id + " in the variable", false);
			int[] mls = mlst.get_list_selections();
			speak(mls.length() + " multiselection list items selected", false);
			if (inp.text.length() < 1) speak("No text is provided", false);
			else speak("Text is:\n" + inp.text, false);
			if (spin.text != "") speak(spin.text);
			continue;
		} else if (f.is_pressed(btne)) {
			if (!btne.enabled) speak("Unavailable");
			else speak("Subscribed");
		}
		wait(5);
	}
}
bool on_x_click(nv_form_control@ctrl) {
	alert("ok", "goodbye");
	string r = generate_profile();
	if (!r.empty()) {
		file f;
		f.open("profile.log", "w");
		f.write(r);
		f.close();
	}
	exit();
	return true;
}
sound snd;
void keyboard_loop() {
	if (key_pressed(KEY_SPACE)) {
		if (!snd.active) snd.load("C:\\Windows\\Media\\Speech Misrecognition.wav");
		if (snd.playing) snd.stop();
		snd.play();
		speak("Should play");
	}
}
void selectinput(nv_form_event@ e) {
	if (e.type != NV_FORM_EVENT_FOCUS_GAINED) return;
	nv_form_input@ c = cast < nv_form_input@ > (e.ctrl);
	if (@c == null) return; // Invalid
	c.select(0);
}
