#include "utils/*.nvgt"

string get_nv_form_control_type_string(int ct) {
	switch (ct) {
		case NV_FORM_CT_BUTTON: return "button";
		case NV_FORM_CT_INPUT: return "edit";
		case NV_FORM_CT_SPIN: return "spin edit";
		case NV_FORM_CT_CHECKBOX: return "check box";
		case NV_FORM_CT_PROGRESS: return "progress bar";
		case NV_FORM_CT_LIST: return "list";
		case NV_FORM_CT_SLIDER: return "slider";
		case NV_FORM_CT_KEYBOARD_AREA: return "keyboard area";
		case NV_FORM_CT_LINK: return "link";
		case NV_FORM_CT_SWITCH: return "switch";
		case NV_FORM_CT_TAB_CONTROL: return "Tab control";
		case NV_FORM_CT_TREEVIEW: return "tree view";
		case NV_FORM_CT_TABLE: return "table";
		default: return "";
	}
}
interface nv_utility_form {
	void monitor();
}
// Function definition for utility factories
funcdef nv_utility_form@ nv_utility_factory(nv_form@ parent, nv_form_control@ ctrl);
class nv_util_reg {
	nv_shortcut@ shortcut;
	uint flag;
	nv_utility_factory@ factory;
	nv_util_reg(nv_shortcut@ sc, uint f, nv_utility_factory@ fac) {
		@shortcut = @sc;
		flag = f;
		@factory = @fac;
	}
}
// Global registry of utility forms
nv_util_reg@[] nv_utilities = {
	nv_util_reg(nv_shortcut(KEY_G, true, false, false, 1), NV_UTIL_GO_INDEX, @create_nv_go_to_index),
	nv_util_reg(nv_shortcut(KEY_F, true, false, false, 1), NV_UTIL_SEARCH, @create_nv_search_for)
};
void register_nv_util(nv_shortcut@ shortcut, uint flag, nv_utility_factory@ factory) {
	nv_utilities.insert_last(nv_util_reg(shortcut, flag, factory));
}
bool handle_nv_utils(nv_form_control@ ctrl) {
	if (@ctrl == null) return false;
	nv_form@ parent = ctrl.parent;
	if (@parent == null) return false;
	int[] supported_types = {NV_FORM_CT_LIST, NV_FORM_CT_INPUT, NV_FORM_CT_TREEVIEW, NV_FORM_CT_TAB_CONTROL};
	if (supported_types.find(ctrl.type) < 0) return false;
	nv_form_input@ inp = cast<nv_form_input@>(ctrl);
	if (@inp != null && inp.password_mask != "") return false;
	if (key_repeating(KEY_F3) && (ctrl.util_flags & NV_UTIL_SEARCH) != 0) {
		string last_search = "";
		if (parent.nv_utility_form_data.get("last_search", last_search)) {
			bool match_all_cases = true;
			if (parent.nv_utility_form_data.exists("match_all_cases")) parent.nv_utility_form_data.get("match_all_cases", match_all_cases);
			parent.search(ctrl, last_search, (keyboard_modifiers & KEYMOD_SHIFT) == 0 ? 1 : -1, false, match_all_cases);
		} else {
			nv_utility_form@ search_util = create_nv_search_for(parent, ctrl);
			if (@search_util != null) @parent.nv_utility_form = search_util;
		}
		return true;
	}
	for (uint i = 0; i < nv_utilities.length(); i++) {
		nv_util_reg@ reg = nv_utilities[i];
		bool flag_matched = (reg.flag == 0) || ((ctrl.util_flags & reg.flag) != 0);
		if (!flag_matched) continue;
		// Check if the form's shortcut manager reports this shortcut as pressed
		if (@reg.shortcut != null && @parent.shortcut != null && parent.shortcut.is_pressed(reg.shortcut)) {
			parent.shortcut.consume();
			if (@reg.factory != null) {
				nv_utility_form@ util = reg.factory(parent, ctrl);
				if (@util != null) {
					return true;
				}
			}
		}
	}
	return false;
}
