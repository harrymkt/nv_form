class nv_form_button: nv_form_control {
	bool pressed;
	nv_form_button(nv_form@parent, const string &in caption, const string &in id = "", bool pressed = false) {
		super(caption, id, NV_FORM_CT_BUTTON, @parent);
		this.pressed = pressed;
	}
	bool monitor() { return pressed; }
	void fire() {
		pressed = true;
		nv_form_control::fire();
	}
	bool handle_input() {
		if (key_pressed(KEY_SPACE) || key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER)) {
			fire();
			return true;
		}
		return false;
	}
}
