class nv_form_input: nv_form_control {
	string text;
	private string __default_text__;
	string password_mask;
	string highlight_select_speech_text = "selected", highlight_unselect_speech_text = "unselected", delete_speech_text = "";
	int cursor = 0;
	int sel_start = -1;
	int sel_end = -1;
	int max_length = 0;
	bool read_only = false;
	bool multiline = false;
	bool overwrite = false;
	bool enable_delete = true;
	string delete_disabled_message = "This input has disabled deletion";
	int echo_flag = TEXTFLAG_ENTRY_CHARACTERS;
	uint8 clipboard_flags = NV_CLIPBOARD_FLAG_COPY | NV_CLIPBOARD_FLAG_CUT | NV_CLIPBOARD_FLAG_PASTE;
	string[] disallowed_chars;
	bool use_only_disallowed_chars = false;
	string char_disallowed_description = "";
	nv_form_input(nv_form@parent, const string &in caption, const string &in id = "") {
		super(caption, id, NV_FORM_CT_INPUT, @parent);
		echo_flag = this.parent.keyboard_echo;
		@touch = touch_gesture_manager();
		dictionary touches = {
			{"swipe_up1f", KEY_UP},
			{"swipe_down1f", KEY_DOWN}
		};
		touch.add_touch_interface(touch_keyboard_interface(touch, touches));
	}
	string get_control_info() {
		validate_positions();
		string f;
		if (password_mask != "") {
			if (text.length() > 0)
				f = utf8length(text) + " characters";
			else
				f = "blank";
		} else {
			if (text.length() > 0) {
				if (has_selection) {
					if (sel_end - sel_start + 1 >= 1024)
						f = highlight_select_speech_text + " " + utf8length(selected_text) + " characters";
					else
						f = highlight_select_speech_text + " " + selected_text;
				} else
					f = read_line(find_line_start(cursor));
			} else
				f = "blank";
		}
		return f;
	}
	string get_fixed_type_first() property {
		string[] f;
		if (read_only) f.insert_last("read only");
		return join(f, " ");
	}
	string get_fixed_type_last() property {
		string[] f;
		if (password_mask != "") f.insert_last("protected");
		if (multiline) f.insert_last("multi line");
		string[] g = control_info_array;
		if (g.length() > 0) f.extend(g);
		return join(f, " ");
	}
	bool handle_input() {
		if (@parent.current_control != @this) return false;
		if (@touch != null) touch.monitor();
		validate_positions();
		string char = get_characters();
		bool ctrl = key_down(KEY_LCTRL) || key_down(KEY_RCTRL);
		bool shift = key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT);
		if (!read_only && enabled) {
			if (char != "") {
				if (disallowed_chars.length() > 0 && is_disallowed_char(char)) {
					if (char_disallowed_description != "") speak(char_disallowed_description);
					return true;
				}
				if (overwrite)
					edit(char);
				else
					add(char);
				return true;
			}
			if (multiline && shift && (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER))) {
				add_new_line();
				return true;
			}
			if ((clipboard_flags & NV_CLIPBOARD_FLAG_CUT) != 0 && ctrl && key_repeating(KEY_X)) {
				cut_highlighted();
				return true;
			}
			if ((clipboard_flags & NV_CLIPBOARD_FLAG_PASTE) != 0 && ((ctrl && key_repeating(KEY_V)) || key_pressed(KEY_PASTE))) {
				paste_text();
				return true;
			}
			if (key_repeating(KEY_BACK)) {
				if (!enable_delete) {
					speak(delete_disabled_message);
					return true;
				}
				if (ctrl && !has_selection) {
					delete_word_left();
					return true;
				}
				delete_highlighted();
				return true;
			}
			if (key_repeating(KEY_DELETE)) {
				if (!enable_delete) {
					speak(delete_disabled_message);
					return true;
				}
				if (ctrl && !has_selection) {
					delete_word_right();
					return true;
				}
				delete_highlighted(1);
				return true;
			}
		}
		if (ctrl && !shift && key_repeating(KEY_A)) {
			highlight_all();
			return true;
		}
		if (key_repeating(KEY_F2)) {
			int dir = 1;
			if ((keyboard_modifiers & KEYMOD_SHIFT) != 0) dir = -1;
			nvform_keyboard_echo = nvform_change_keyboard_echo(echo_flag, dir);
			parent.set_keyboard_echo(nvform_keyboard_echo);
			echo_flag = nvform_keyboard_echo;
			speak(nvform_keyboard_echo_string(nvform_keyboard_echo));
			return true;
		}
		if ((clipboard_flags & NV_CLIPBOARD_FLAG_COPY) != 0 && ctrl && key_repeating(KEY_C)) {
			copy_highlighted();
			return true;
		}
		if (key_repeating(KEY_LEFT)) {
			if (ctrl)
				move_word_left(shift);
			else if (shift)
				highlight_left();
			else
				move_left();
			return true;
		}
		if (key_repeating(KEY_RIGHT)) {
			if (ctrl)
				move_word_right(shift);
			else if (shift)
				highlight_right();
			else
				move_right();
			return true;
		}
		if (key_repeating(KEY_UP)) {
			if (shift)
				highlight_up();
			else
				previous_line();
			return true;
		}
		if (key_repeating(KEY_DOWN)) {
			if (shift)
				highlight_down();
			else
				next_line();
			return true;
		}
		if (key_repeating(KEY_HOME)) {
			if (ctrl || !multiline) {
				if (shift)
					highlight_to_field_start();
				else
					field_start();
			} else {
				if (shift)
					highlight_to_line_start();
				else
					line_start();
			}
			return true;
		}
		if (key_repeating(KEY_END)) {
			if (ctrl || !multiline) {
				if (shift)
					highlight_to_field_end();
				else
					field_end();
			} else {
				if (shift)
					highlight_to_line_end();
				else
					line_end();
			}
			return true;
		}
		if (handle_nv_utils(this)) return true;
		return false;
	}
	void on_focus_gained() {
		start_text_input();
		get_characters();
	}
	bool get_has_selection() const property {
		return sel_start > -1 && sel_end >= sel_start && sel_start < int(text.length());
	}
	string get_selected_text() const property {
		if (!has_selection) return "";
		return text.substr(sel_start, sel_end - sel_start + 1);
	}
	void validate_positions() {
		int length = text.length();
		if (cursor < 0) cursor = 0;
		if (cursor > length) cursor = length;
		if (sel_start < 0 || sel_end < sel_start || sel_start >= length) {
			sel_start = -1;
			sel_end = -1;
		} else if (sel_end >= length)
			sel_end = length - 1;
	}
	bool is_separator(int position) {
		if (position < 0 || position >= int(text.length())) return false;
		return nvform_word_separators.find(text[position]) > -1;
	}
	int find_line_start(int position) {
		if (position > int(text.length())) position = text.length();
		while (position > 0 && text[position - 1] != "\n") position--;
		return position;
	}
	int find_line_end(int position) {
		if (position < 0) position = 0;
		while (position < int(text.length()) && text[position] != "\n") position++;
		return position;
	}
	int find_previous_line(int position) {
		int start = find_line_start(position);
		if (start == 0) return 0;
		return find_line_start(start - 1);
	}
	int find_next_line(int position) {
		int end = find_line_end(position);
		if (end >= int(text.length())) return text.length();
		return end + 1;
	}
	int find_previous_word(int position) {
		if (password_mask != "") return find_line_start(position);
		while (position > 0 && is_separator(position - 1)) position--;
		while (position > 0 && !is_separator(position - 1)) position--;
		return position;
	}
	int find_next_word(int position) {
		if (password_mask != "") return find_line_end(position);
		int length = text.length();
		while (position < length && !is_separator(position)) position++;
		while (position < length && is_separator(position)) position++;
		return position;
	}
	bool add(const string &in character, bool silent = false) {
		if (read_only || character == "") return false;
		validate_positions();
		string new_text = text;
		int position = cursor;
		bool replaced = false;
		if (has_selection) {
			new_text = text.substr(0, sel_start) + text.substr(sel_end + 1);
			position = sel_start;
			replaced = true;
		}
		if (max_length > 0 && utf8length(new_text) + utf8length(character) > max_length)
			return false;
		text = new_text.substr(0, position) + character + new_text.substr(position);
		cursor = position + character.length();
		sel_start = -1;
		sel_end = -1;
		echo(character);
		nv_form_input_event e(this);
		e.character = character;
		event.fire(e);
		if (!silent && replaced) speak(highlight_unselect_speech_text, false);
		update_suggestions();
		return true;
	}
	bool edit(const string &in character) {
		if (read_only || character == "") return false;
		validate_positions();
		if (has_selection || cursor >= int(text.length()) || text[cursor] == "\n")
			return add(character);
		int size = utf8size(text.substr(cursor, 4));
		text = text.substr(0, cursor) + character + text.substr(cursor + size);
		cursor += character.length();
		echo(character);
		nv_form_input_event e(this);
		e.character = character;
		event.fire(e);
		update_suggestions();
		return true;
	}
	void echo(const string &in character) {
		if (echo_flag == TEXTFLAG_ENTRY_CHARACTERS || echo_flag == TEXTFLAG_ENTRY_CHARACTERS_WORDS)
			speak(input_box_speak(find_appropriate_character(character)));
		if (nvform_word_separators.find(character) < 0 || (echo_flag != TEXTFLAG_ENTRY_WORDS && echo_flag != TEXTFLAG_ENTRY_CHARACTERS_WORDS))
			return;
		int end = cursor - character.length();
		int start = end;
		while (start > 0 && !is_separator(start - 1)) start--;
		if (end > start)
			speak(get_masked_text(text.substr(start, end - start)), echo_flag != TEXTFLAG_ENTRY_CHARACTERS_WORDS);
	}
	void update_suggestions() {
		if (@suggestion == null || password_mask != "") return;
		suggestion.update();
	}
	string input_box_speak(const string &in character) {
		return input_box_speak(character, false);
	}
	string input_box_speak(const string &in character, bool ignore_echo_flag) {
		if (character == " ")
			return "Space";
		else if (character == "\n")
			return "line feed";
		else if (character == "blank") return character;
		else if (character == "\t") return "tab";
		string oc = nv_get_readable_key(character, true);
		if (oc != "") return oc;
		if ((echo_flag == TEXTFLAG_ENTRY_NONE) && (ignore_echo_flag == false))
			return "";
		if (character.is_alphanumeric()) {
			if (character.is_upper())
				return "Capital " + character + " ";
			else
				return character + " ";
		}
		return character + " ";
	}
	string find_appropriate_character(string original_character) {
		original_character.resize(utf8size(original_character));
		if (password_mask == "")
			return original_character;
		else
			return password_mask;
	}
	string describe_text(const string &in value) {
		if (value == "") return "blank";
		uint length = utf8length(value);
		if (length == 1) return input_box_speak(find_appropriate_character(value), true).trim_whitespace();
		if (password_mask != "" || value.length() >= 1024) return length + " characters";
		return value;
	}
	void speak_character() {
		if (cursor >= int(text.length()))
			speak("Blank");
		else
			speak(input_box_speak(find_appropriate_character(text.substr(cursor, 4)), true), true);
	}
	void move_left() {
		sel_start = -1;
		sel_end = -1;
		cursor = utf8prev(text, cursor);
		if (cursor < 0)
			cursor = 0;
		speak_character();
	}
	void move_right() {
		sel_start = -1;
		sel_end = -1;
		cursor = utf8next(text, cursor);
		if (cursor > int(text.length()))
			cursor = text.length();
		speak_character();
	}
	void add_new_line() {
		if (!multiline)
			return;
		add("\n");
	}
	int current_line_start_position(bool word = false) {
		if (text == "")
			return -1;
		if (!word) return find_line_start(cursor);
		int position = cursor;
		while (position > 0 && !is_separator(position - 1)) position--;
		return position;
	}
	string read_line(int position) {
		if (position < 0) position = 0;
		if (position > int(text.length())) position = text.length();
		string line = text.substr(position, find_line_end(position) - position);
		if (line == "")
			return "Blank";
		return get_masked_text(line);
	}
	void line_start() {
		sel_start = -1;
		sel_end = -1;
		if (text == "") {
			speak("Blank");
			return;
		}
		cursor = find_line_start(cursor);
		speak_character();
	}
	void line_end() {
		cursor = find_line_end(cursor);
		speak("Blank");
		sel_start = -1;
		sel_end = -1;
	}
	void move_word_left(bool highlighting = false, bool speak_selection_status = true) {
		if (text == "") {
			if (speak_selection_status) speak("Blank");
			return;
		}
		int target = find_previous_word(cursor);
		if (highlighting) {
			extend_selection(target, !speak_selection_status);
			return;
		}
		unselect(true);
		cursor = target;
		speak_word();
	}
	void move_word_right(bool highlighting = false, bool speak_selection_status = true) {
		if (text == "") {
			if (speak_selection_status) speak("Blank");
			return;
		}
		int target = find_next_word(cursor);
		if (highlighting) {
			extend_selection(target, !speak_selection_status);
			return;
		}
		unselect(true);
		cursor = target;
		speak_word();
	}
	void speak_word() {
		if (cursor >= int(text.length())) {
			speak("Blank");
			return;
		}
		string word = password_mask != "" ? "" : read_word_from_position(cursor);
		if (word == "")
			speak_character();
		else
			speak(word, true, null);
	}
	void field_start() {
		cursor = 0;
		sel_start = -1;
		sel_end = -1;
		if (text.length() == 0) {
			speak("Blank", true);
			return;
		}
		if (multiline) {
			string slt = read_line(0);
			speak(slt, true, (slt != "" ? null : tts_default_text_processing_callback));
		} else
			speak_character();
	}
	void field_end() {
		sel_start = -1;
		sel_end = -1;
		cursor = text.length();
		if (text.length() == 0 || !multiline) {
			speak("Blank", true);
			return;
		}
		string slt = read_line(find_line_start(cursor));
		speak(slt, true, (slt != "" ? null : tts_default_text_processing_callback));
	}
	string read_word_from_position(int position) {
		if (text == "" || position < 0 || position >= int(text.length()))
			return "";
		int end = position;
		while (end < int(text.length()) && !is_separator(end)) end++;
		return get_masked_text(text.substr(position, end - position));
	}
	void extend_selection(int target, bool silent = false) {
		validate_positions();
		int length = text.length();
		if (target < 0) target = 0;
		if (target > length) target = length;
		if (target == cursor) return;
		int anchor = cursor;
		if (has_selection) anchor = cursor <= sel_start ? sel_end + 1 : sel_start;
		int previous = cursor;
		cursor = target;
		if (cursor == anchor) {
			sel_start = -1;
			sel_end = -1;
		} else {
			sel_start = cursor < anchor ? cursor : anchor;
			sel_end = (cursor > anchor ? cursor : anchor) - 1;
		}
		if (silent) return;
		if ((previous < anchor && target > anchor) || (previous > anchor && target < anchor)) {
			speak_range(previous, anchor, true, true);
			speak_range(anchor, target, false, false);
			return;
		}
		int previous_distance = previous > anchor ? previous - anchor : anchor - previous;
		int target_distance = target > anchor ? target - anchor : anchor - target;
		speak_range(previous, target, target_distance < previous_distance, true);
	}
	void speak_range(int from, int to, bool unselect, bool interrupt) {
		if (from == to) return;
		int start = from < to ? from : to;
		int end = from < to ? to : from;
		speak_selected(text.substr(start, end - start), unselect, interrupt);
	}
	void highlight_to_field_start() {
		extend_selection(0);
	}
	void highlight_to_field_end() {
		extend_selection(text.length());
	}
	void highlight_to_word_start() {
		move_word_left(true);
	}
	void highlight_to_word_end() {
		move_word_right(true);
	}
	void highlight_to_line_start(bool continuation = false) {
		extend_selection(continuation ? find_previous_line(cursor) : find_line_start(cursor));
	}
	void highlight_to_line_end(bool continuation = false) {
		extend_selection(continuation ? find_next_line(cursor) : find_line_end(cursor));
	}
	void highlight_left() {
		if (cursor <= 0) return;
		extend_selection(utf8prev(text, cursor));
	}
	void highlight_right() {
		if (cursor >= int(text.length())) return;
		extend_selection(utf8next(text, cursor));
	}
	void highlight_up() {
		if (!multiline)
			highlight_to_field_start();
		else
			highlight_to_line_start(true);
	}
	void highlight_down() {
		if (!multiline)
			highlight_to_field_end();
		else
			highlight_to_line_end(true);
	}
	void highlight_by_position(int start, int end) {
		select(start, end);
	}
	bool unselect(bool silent = false) {
		if (sel_start > -1 && sel_end > -1) {
			sel_start = -1;
			sel_end = -1;
			if (!silent) speak(highlight_unselect_speech_text);
			return true;
		}
		return false;
	}
	void next_line() {
		bool prevsl = unselect(true);
		int length = text.length();
		if (!multiline) {
			cursor = length;
			speak(read_line(0));
		} else {
			int end = find_line_end(cursor);
			if (end >= length) {
				cursor = length;
				speak(read_line(find_line_start(cursor)));
			} else {
				cursor = end + 1;
				speak(read_line(cursor));
			}
		}
		if (prevsl) speak(highlight_unselect_speech_text, false);
	}
	void previous_line() {
		bool prevsl = unselect(true);
		int start = find_line_start(cursor);
		if (!multiline || start == 0)
			cursor = 0;
		else
			cursor = find_line_start(start - 1);
		speak(read_line(cursor));
		if (prevsl) speak(highlight_unselect_speech_text, false);
	}
	void highlight_all() {
		if (text == "") {
			sel_start = -1;
			sel_end = -1;
			speak("nothing to select");
			return;
		}
		sel_start = 0;
		sel_end = text.length() - 1;
		cursor = text.length();
		speak_selected(text);
	}
	string get_masked_text(const string &in t) {
		if (password_mask == "")
			return t;
		int len = utf8length(t);
		if (len <= 0) return "";
		if (len == 1) return password_mask;
		return len + " characters";
	}
	protected void speak_selected(const string &in selection, bool unselect = false, bool interrupt = true) {
		string speech_text = unselect ? highlight_unselect_speech_text : highlight_select_speech_text;
		speak(describe_text(selection) + " " + speech_text, interrupt);
	}
	void copy_highlighted() {
		if (password_mask != "") {
			speak("Cannot copy from a protected field.", true);
			return;
		}
		if (!has_selection) {
			speak("Nothing selected", true);
			return;
		}
		clipboard_set_text(selected_text);
		speak("Copied to clipboard", true);
	}
	void cut_highlighted() {
		if (read_only == true) {
			speak("Cannot cut from a read only edit box.", true);
			return;
		}
		if (password_mask != "") {
			speak("Cannot cut from a protected field.", true);
			return;
		}
		if (!has_selection) {
			speak("Nothing selected", true);
			return;
		}
		clipboard_set_text(selected_text);
		speak("Cut Selected", true);
		delete_highlighted(0, false);
	}
	void paste_text() {
		if (read_only) return;
		validate_positions();
		string paste = clipboard_get_text().replace("\r\n", "\n", true).replace("\r", "\n", true);
		if (!multiline) {
			int line_break = paste.find("\n");
			if (line_break > -1) paste = paste.substr(0, line_break);
		}
		if (paste == "") {
			speak("clipboard empty", true);
			return;
		}
		int selected_length = has_selection ? utf8length(selected_text) : 0;
		if (max_length > 0 && (utf8length(text) + utf8length(paste) - selected_length) > max_length) {
			speak("clipboard data can't fit", true);
			return;
		}
		if (disallowed_chars.length() > 0 && is_disallowed_char(paste)) {
			if (char_disallowed_description != "") speak(char_disallowed_description);
			return;
		}
		string new_text = text;
		if (has_selection) {
			cursor = sel_start;
			new_text = text.substr(0, sel_start) + text.substr(sel_end + 1);
			sel_start = -1;
			sel_end = -1;
		}
		text = new_text.substr(0, cursor) + paste + new_text.substr(cursor);
		cursor += paste.length();
		speak("Text Pasted", true);
		nv_form_input_event e(this);
		e.character = paste;
		event.fire(e);
		update_suggestions();
	}
	void delete_word_left() {
		if (read_only || text == "") return;
		validate_positions();
		if (has_selection) {
			delete_highlighted(0);
			return;
		}
		int target = find_previous_word(cursor);
		if (target < cursor) delete_range(target, cursor, true);
	}
	void delete_word_right() {
		if (read_only || text == "") return;
		validate_positions();
		if (has_selection) {
			delete_highlighted(1);
			return;
		}
		int target = find_next_word(cursor);
		if (target > cursor) delete_range(cursor, target, true);
	}
	void delete_range(int start, int end, bool speak_deleted) {
		string removed = text.substr(start, end - start);
		text = text.substr(0, start) + text.substr(end);
		cursor = start;
		sel_start = -1;
		sel_end = -1;
		if (speak_deleted)
			speak(describe_text(removed) + (delete_speech_text != "" ? " " + delete_speech_text : ""), true);
		nv_form_input_event e(this);
		e.character = removed;
		e.deleted = true;
		event.fire(e);
		update_suggestions();
	}
	void delete_highlighted() {
		delete_highlighted(0);
	}
	void delete_highlighted(int from_start) {
		delete_highlighted(from_start, true);
	}
	void delete_highlighted(int from_start, bool speak_deleted) {
		if ((text == "") || (read_only == true))
			return;
		validate_positions();
		if (has_selection) {
			if (speak_deleted)
				speak("selection deleted");
			delete_range(sel_start, sel_end + 1, false);
		} else if (from_start == 0 && cursor > 0)
			delete_range(utf8prev(text, cursor), cursor, speak_deleted);
		else if (from_start == 1 && cursor < int(text.length()))
			delete_range(cursor, utf8next(text, cursor), speak_deleted);
	}
	bool select(int sel_start = -1, int sel_end = -1) {
		int length = text.length();
		if (sel_start < 0) {
			this.sel_start = -1;
			this.sel_end = -1;
			return true;
		}
		if (sel_start >= length) return false;
		if (sel_end < 0 || sel_end >= length)
			sel_end = length - 1;
		if (sel_end < sel_start) return false;
		this.sel_start = sel_start;
		this.sel_end = sel_end;
		return true;
	}
	int get_line_number() {
		int ln = 1;
		for (int i = 0; i < int(text.length()) and i < cursor; i++) {
			if (text[i] == "\n") ln++;
		}
		return ln;
	}
	int get_line_column() {
		validate_positions();
		int col = 1;
		int position = find_line_start(cursor);
		while (position < cursor) {
			int next = utf8next(text, position);
			if (next <= position) break;
			position = next;
			col++;
		}
		return col;
	}
	bool set_line(int line, int col = 1, bool silent = false) {
		if (type != NV_FORM_CT_INPUT) return false;
		if (line < 1) {
			if (!silent) speak("line number out of range");
			return false;
		}
		int line_start = 0;
		if (line > 1) {
			int break_before = nv_string_contains(text, "\n", line - 1);
			if (break_before < 0) {
				if (!silent) speak("line number out of range");
				return false;
			}
			line_start = break_before + 1;
		}
		int line_end = find_line_end(line_start);
		cursor = line_start;
		for (int i = 1; i < col && cursor < line_end; i++) {
			int next = utf8next(text, cursor);
			if (next <= cursor) break;
			cursor = next;
		}
		if (cursor > line_end) cursor = line_end;
		sel_start = -1;
		sel_end = -1;
		if (!silent) speak(read_line(find_line_start(cursor)), false);
		return true;
	}
	string get_default_text() const property {
		return __default_text__;
	}
	void set_default_text(string v) property {
		while ((max_length > 0) && (utf8length(v) > max_length))
			v = v.substr(0, utf8prev(v, v.length()));
		__default_text__ = v;
		text = v;
		validate_positions();
	}
	bool search(const string &in text, int dir = 1, bool silent = false) {
		validate_positions();
		string wrapped = "";
		int idx = -1;
		if (dir > 0)
			idx = this.text.find(text, cursor + 1);
		else if (cursor > 0)
			idx = this.text.rfind(text, cursor - 1);
		if (idx < 0) {
			wrapped = dir > 0 ? "wrapped to top" : "wrapped to bottom";
			idx = dir > 0 ? this.text.find(text, 0) : this.text.rfind(text, -1);
		}
		if (idx < 0) {
			if (!silent) speak("nothing found");
			return false;
		}
		if (cursor == idx) {
			if (!silent) speak("nothing else found");
			return false;
		}
		cursor = idx;
		sel_start = -1;
		sel_end = -1;
		if (!silent) {
			if (wrapped != "") speak(wrapped);
			speak(read_line(find_line_start(cursor)), wrapped == "");
		}
		return true;
	}
	bool set_disallowed_chars(const string &in chars, bool use_only_disallowed_chars = false, const string &in char_disallowed_description = "") {
		disallowed_chars.resize(0);
		for (uint i = 0; i < chars.length(); ) {
			uint next = utf8next(chars, i);
			if (next <= i) next = i + 1;
			disallowed_chars.insert_last(chars.substr(i, next - i));
			i = next;
		}
		this.use_only_disallowed_chars = use_only_disallowed_chars;
		this.char_disallowed_description = char_disallowed_description;
		return true;
	}
	bool is_disallowed_char(const string &in char, bool search_all = true) {
		if (char.length() < 1)
			return false;
		if (search_all) {
			for (uint i = 0; i < char.length(); ) {
				uint next = utf8next(char, i);
				if (next <= i) next = i + 1;
				string one = char.substr(i, next - i);
				if (disallowed_chars.find(one) < 0 && use_only_disallowed_chars) return true;
				else if (disallowed_chars.find(one) > -1 && !use_only_disallowed_chars) return true;
				i = next;
			}
			return false;
		}
		return (disallowed_chars.find(char) > -1 && !use_only_disallowed_chars) || (disallowed_chars.find(char) < 0 && use_only_disallowed_chars);
	}
	uint utf8length(const string &in txt) const {
		if (txt.empty()) return 0;
		uint length = txt.length(), count = 0;
		for (uint cursor = 0; length > cursor; count ++)
			cursor = utf8next(txt, cursor);
		return count;
	}
}
