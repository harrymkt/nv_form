class nv_form_checkbox: nv_form_control {
	bool state = false;
	nv_form_checkbox(nv_form@parent, const string &in caption, const string &in id = "", bool initial_state = false) {
		super(caption, id, NV_FORM_CT_CHECKBOX, @parent);
		this.state = initial_state;
		@touch = touch_gesture_manager();
		dictionary touches = {{"double_tap1f", KEY_SPACE}};
		touch.add_touch_interface(touch_keyboard_interface(touch, touches));
	}
	void fire() {
		if (!enabled) return;
		toggle();
		if (!send_callback()) return;
		speak(fixed_type_last);
	}
	string get_fixed_type_last() property {
		return (state ? "checked" : "not checked");
	}
	void toggle() {
		state = !state;
		event.fire(nv_form_event(this, NV_FORM_EVENT_CHECKBOX_TOGGLED));
	}
	bool check() {
		if (state) return false;
		state = true;
		event.fire(nv_form_event(this, NV_FORM_EVENT_CHECKBOX_TOGGLED));
		return true;
	}
	bool uncheck() {
		if (!state) return false;
		state = false;
		event.fire(nv_form_event(this, NV_FORM_EVENT_CHECKBOX_TOGGLED));
		return true;
	}
	bool handle_input() {
		if (@touch != null) touch.monitor();
		if (key_pressed(KEY_SPACE)) {
			fire();
			return true;
		}
		return false;
	}
}
