class nv_form_tree_node {
	string text;
	string id;
	int level;
	bool expanded;
	nv_form_tree_node@ parent;
	nv_form_tree_node@[] nodes;
	nv_form_tree_node(const string &in text, const string &in id = "", int level = 0, nv_form_tree_node@ parent = null) {
		this.text = text;
		this.id = id;
		this.level = level;
		expanded = false;
		@this.parent = parent;
	}
	nv_form_tree_node@ add(const string &in text, const string &in id = "") {
		nv_form_tree_node child(text, id, this.level + 1, @this);
		nodes.insert_last(child);
		return child;
	}
	int get_item_index(const string &in id) const {
		if (nodes.length() < 1) return -1;
		for (uint i = 0; i < nodes.length(); i++) {
			if (nodes[i].id == id) return i;
		}
		return -1;
	}
	bool remove(const string &in id) {
		int x = get_item_index(id);
		if (x < 0) return false;
		@nodes[x] = null;
		nodes.remove_at(x);
		return true;
	}
	bool get_has_nodes() const property {
		return nodes.length() > 0;
	}
	string[] get_ids() const property {
		string[] f;
		if (id != "") f.insert_last(id);
		if (@parent != null) f.insert(0, parent.ids);
		return f;
	}
	string full_id(const string &in sep) const {
		return join(ids, sep);
	}
}
class nv_form_treeview : nv_form_control {
	nv_form_tree_node@[] nodes;
	nv_form_tree_node@[] visible_nodes;
	int pos = -1;
	bool multinav = true;
	timer multinavtime;
	string multichar;
	nv_form_treeview(nv_form@ parent, const string &in caption, const string &in id = "") {
		super(caption, id, NV_FORM_CT_TREEVIEW, @parent);
	}
	int get_item_index(const string &in id) const {
		if (nodes.length() < 1) return -1;
		for (uint i = 0; i < nodes.length(); i++) {
			if (nodes[i].id == id) return i;
		}
		return -1;
	}
	int get_visible_item_index(const string &in id) const {
		if (visible_nodes.length() < 1) return -1;
		for (uint i = 0; i < visible_nodes.length(); i++) {
			if (visible_nodes[i].id == id) return i;
		}
		return -1;
	}
	nv_form_tree_node@ add(const string &in text, const string &in id = "") {
		nv_form_tree_node node(text, id, 0, null);
		nodes.insert_last(node);
		rebuild();
		return node;
	}
	bool remove(const string &in id) {
		int x = get_item_index(id);
		if (x < 0) return false;
		@nodes[x] = null;
		nodes.remove_at(x);
		rebuild();
		return true;
	}
	void rebuild() {
		nv_form_tree_node@ current_focused = get_focused_node();
		visible_nodes.resize(0);
		for (uint i = 0; i < nodes.length(); i++) {
			add_node_to_visible_recursive(nodes[i]);
		}
		pos = -1;
		if (@current_focused != null) {
			for (uint i = 0; i < visible_nodes.length(); i++) {
				if (@visible_nodes[i] == @current_focused) {
					set_pos(i, fire_event = true);
					break;
				}
			}
		}
	}
	void add_node_to_visible_recursive(nv_form_tree_node@ node) {
		if (@node == null) return;
		visible_nodes.insert_last(node);
		if (node.expanded && node.has_nodes) {
			for (uint i = 0; i < node.nodes.length(); i++) {
				add_node_to_visible_recursive(node.nodes[i]);
			}
		}
	}
	nv_form_tree_node@ get_focused_node() const property {
		if (pos < 0 || pos >= visible_nodes.length()) return null;
		return visible_nodes[pos];
	}
	string get_focused_node_id() const property {
		nv_form_tree_node@ node = focused_node;
		if (@node == null) return "";
		return node.id;
	}
	bool set_pos(int index, bool autobound = true, bool fire_event = false) {
		if (visible_nodes.length() <= 0) {
			return false;
		}
		if (autobound) {
			if (index < 0) index = 0;
			if (index >= visible_nodes.length()) index = visible_nodes.length() - 1;
		}
		if (index < 0 || index > visible_nodes.length() - 1) return false;
		int opos = pos;
		pos = index;
		if (fire_event) {
			dictionary a;
			a.set("old_pos", opos);
			fire_item_change_event(a);
		}
		return true;
	}
	void fire_item_change_event(dictionary@ args) {
		nv_form_treeview_event l(this);
		int oldpos;
		if (args.get("old_pos", oldpos)) l.old_pos = oldpos;
		event.fire(l);
	}
	int find_multinav_position(const string &in prefix) {
		if (prefix == "" || visible_nodes.length() <= 0) return -1;
		string current_prefix;
		if (pos >= 0 && pos < visible_nodes.length())
			current_prefix = visible_nodes[pos].text.lower().substr(0, prefix.length());
		for (int i = pos; i < visible_nodes.length(); i++) {
			if (i < 0 || i >= visible_nodes.length()) continue;
			if (i == pos) continue;
			if (visible_nodes[i].text.lower().substr(0, prefix.length()) == prefix) {
				if (current_prefix == prefix && prefix.length() > 1) return pos;
				return i;
			}
		}
		for (uint i = 0; i < visible_nodes.length(); i++) {
			if (visible_nodes[i].text.lower().substr(0, prefix.length()) == prefix) {
				if (current_prefix == prefix && prefix.length() > 1) return pos;
				return i;
			}
		}
		return -1;
	}
	bool handle_input() {
		if (visible_nodes.length() == 0) return false;
		if (multinav) {
			if (multinavtime.elapsed > 1000 and multichar != "")
				multichar = "";
			string c = get_characters().lower();
			if (c != "" and multichar != c) {
				multinavtime.restart();
				multichar += c;
			}
			if (multichar != "" and c != "") {
				multichar = multichar.lower();
				int position = find_multinav_position(multichar);
				if (position < 0) {
					return false;
				}
				if (position != pos) {
					if (set_pos(position, false, fire_event = true)) speak_current_node();
				} else speak_current_node();
				return true;
			}
		}
		nv_form_tree_node@ node = focused_node;
		if (key_repeating(KEY_DOWN)) {
			if (pos < visible_nodes.length() - 1) {
				set_pos(pos + 1);
				speak_current_node();
				return true;
			}
		}
		if (key_repeating(KEY_UP)) {
			if (pos > 0) {
				set_pos(pos - 1, fire_event = true);
				speak_current_node();
				return true;
			}
		}
		if (key_pressed(KEY_RIGHT) && @node != null) {
			if (node.has_nodes) {
				if (!node.expanded) {
					node.expanded = true;
					rebuild();
					speak("expanded");
					return true;
				} else {
					if (pos < visible_nodes.length() - 1) {
						set_pos(pos + 1, fire_event = true);
						speak_current_node();
						return true;
					}
				}
			}
		}
		if (key_pressed(KEY_LEFT) && @node != null) {
			if (node.has_nodes && node.expanded) {
				node.expanded = false;
				rebuild();
				speak("collapsed");
				return true;
			} else if (@node.parent != null) {
				nv_form_tree_node@ p = node.parent;
				for (uint i = 0; i < visible_nodes.length(); i++) {
					if (@visible_nodes[i] == @p) {
						set_pos(i, fire_event = true);
						speak_current_node();
						return true;
					}
				}
			}
		}
		if (key_repeating(KEY_HOME)) {
			set_pos(0, fire_event = true);
			speak_current_node();
			return true;
		}
		if (key_repeating(KEY_END)) {
			set_pos(visible_nodes.length() - 1, fire_event = true);
			speak_current_node();
			return true;
		}
		if (handle_nv_utils(this)) return true;
		return false;
	}
	void speak_current_node(bool interrupt = tts_default_interrupt) {
		string t = node_str(focused_node);
		if (t != "") speak(t, interrupt);
	}
	string node_str(nv_form_tree_node@ node) const {
		if (@node == null) return "";
		string state = "";
		if (node.has_nodes) {
			state = node.expanded ? "expanded" : "collapsed";
		}
		string info = node.text + "  " + state + "  level " + node.level;
		return info;
	}
	bool search(const string &in text, int dir = 1, bool silent = false) {
		if (visible_nodes.length() < 1) return false;
		string[] nav_nodes(this.visible_nodes.length());
		for (uint i = 0; i < this.visible_nodes.length(); i++)
			nav_nodes[i] = visible_nodes[i].text;
		bool already_on_result = false;
		if (pos > -1) already_on_result = nav_nodes[pos].find(text) > -1;
		string wrapped = "";
		int position = pos;
		if (position < 0) position = 0;
		for (int i = position + dir; i != position; i += dir) {
			if (i < 0) {
				i = visible_nodes.length() - 1;
				wrapped = "wrapped to bottom";
			} else if (i >= visible_nodes.length()) {
				i = 0;
				wrapped = "wrapped to top";
			}
			if (i == position) break;
			if (nav_nodes[i].find(text) < 0) continue;
			if (set_pos(i, false, fire_event = true)) {
				if (!silent) {
					if (wrapped != "") speak(wrapped);
					speak_current_node(false);
				}
				return true;
			}
		}
		if (!silent)
			speak(already_on_result ? "nothing else found" : "nothing found");
		return false;
	}
	string get_control_info() {
		return node_str(focused_node);
	}
}
