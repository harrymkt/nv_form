class nv_form_slider: nv_form_control {
	double min_value, max_value, step, page, value;
	dictionary text;
	nv_form_slider(nv_form@parent, const string &in caption, const string &in id = "", double min_value = 0, double max_value = 100, double step = 1, double initial_value = 0, double page = 0, dictionary@ text = null) {
		super(caption, id, NV_FORM_CT_SLIDER, @parent);
		this.min_value = min_value;
		this.max_value = max_value;
		this.step = step;
		this.page = page;
		value = initial_value;
		if (this.page <= 0) this.page = this.step * 10;
		clamp_value();
		if (@text != null) this.text = text;
		@touch = touch_gesture_manager();
		dictionary touches = {
			{"swipe_up1f", KEY_UP},
			{"swipe_down1f", KEY_DOWN},
			{"swipe_up2f", KEY_HOME},
			{"swipe_down2f", KEY_END}
		};
		touch.add_touch_interface(touch_keyboard_interface(touch, touches));
	}
	void clamp_value() {
		value = clamp(value, min_value, max_value);
	}
	bool set_value(double v) {
		double old_value = value;
		value = v;
		clamp_value();
		if (value != old_value) {
			event.fire(nv_form_event(this, NV_FORM_EVENT_SLIDER_CHANGED));
			return true;
		}
		return false;
	}
	string get_text(double value, const string &in def = "") const {
		string v;
		if (!text.get(value, v)) return def;
		if (v == "" && def != "") v = def;
		return v;
	}
	void set_text(double value, const string &in text) {
		this.text.set(value, text);
	}
	string get_text_value() const property {
		return get_text(value, value);
	}
	bool handle_input() {
		if (@touch != null) touch.monitor();
		if (key_repeating(KEY_DOWN)) {
			set_value(value - step);
			speak(text_value);
			return true;
		} else if (key_repeating(KEY_UP)) {
			set_value(value + step);
			speak(text_value);
			return true;
		} else if (key_repeating(KEY_PAGEUP)) {
			set_value(value + page);
			speak(text_value);
			return true;
		} else if (key_repeating(KEY_PAGEDOWN)) {
			set_value(value - page);
			speak(text_value);
			return true;
		} else if (key_repeating(KEY_HOME)) {
			set_value(min_value);
			speak(text_value);
			return true;
		} else if (key_repeating(KEY_END)) {
			set_value(max_value);
			speak(text_value);
			return true;
		}
		return false;
	}
	string get_control_info() {
		return text_value;
	}
}
