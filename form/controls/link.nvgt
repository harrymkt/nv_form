class nv_form_link: nv_form_control {
	bool pressed;
	string url;
	nv_form_link(nv_form@parent, const string &in caption, const string &in url, const string &in id = "", bool pressed = false) {
		super(caption, id, NV_FORM_CT_LINK, @parent);
		this.pressed = pressed;
		this.url = url;
		@touch = touch_gesture_manager();
		dictionary touches = {{"double_tap1f", KEY_RETURN}};
		touch.add_touch_interface(touch_keyboard_interface(touch, touches));
	}
	bool monitor() { return pressed; }
	void fire() {
		pressed = true;
		urlopen(url);
		nv_form_control::fire();
	}
	bool handle_input() {
		if (@touch != null) touch.monitor();
		if (key_pressed(KEY_SPACE) || key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER)) {
			fire();
			return true;
		}
		return false;
	}
}
