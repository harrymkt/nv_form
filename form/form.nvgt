#include "base_control.nvgt"
#include "controls/*.nvgt"
#include "enums.nvgt"
#include "event.nvgt"
#include "events/*.nvgt"
#include "funcdefs.nvgt"
#include "helper.nvgt"
#include "shortcut.nvgt"
#include "speech.nvgt"
#include "utilities.nvgt"

string nvform_word_separators = "_ .,!\\\"/[{()}]=\n:|";
int nvform_keyboard_echo = TEXTFLAG_ENTRY_CHARACTERS;
nv_form_event_handler@ default_nv_form_event_handler = null;

class nv_form {
	nv_form_control@[]controls;
	int max_controls = 0;
	int control_index = -1;
	protected int __keyboard_echo__ = nvform_keyboard_echo;
	bool rely_on_nvform_echo = true;
	string window_title;
	bool speak_control_attributes_separately = false;
	protected int __tap_timeout__ = 200;
	bool active = false;
	private nv_form_errorcode[] errors;
	nv_form_control@primary_control = null, cancel_control = null;
	nv_form_callback@background_callback = null;
	nv_shortcut_manager@ shortcut;
	nv_form_event_handler@ default_event_handler = null;
	nv_form() {
		reset();
	}
	void reset() {
		window_title = "";
		active = false;
		control_index = -1;
		controls.resize(0);
		@primary_control = null;
		@cancel_control = null;
		@nv_utility_form = null;
		@shortcut = null;
		@default_event_handler = default_nv_form_event_handler;
	}
	int get_keyboard_echo() const property {
		if (rely_on_nvform_echo) return nvform_keyboard_echo;
		return __keyboard_echo__;
	}
	void set_keyboard_echo(int echo, bool update = true) {
		__keyboard_echo__ = echo;
		if (update) {
			foreach (nv_form_control@ l: controls) {
				nv_form_input@ ca = cast < nv_form_input@ > (l);
				if (@ca == null) continue;
				ca.echo_flag = echo;
			}
		}
	}
	int tap_timeout {
		get const {
			return __tap_timeout__;
		} set {
			__tap_timeout__ = value;
			if (@shortcut != null) shortcut.tap_timeout = __tap_timeout__;
		}
	}
	nv_form_control@get_control_by_id(const string &in id) const {
		if (controls.length() <= 0) return null;
		for (uint i = 0; i < controls.length(); i += 1) {
			if (controls[i].id == id) return controls[i];
		}
		return null;
	}
	nv_form_control@get_current_control() const property {
		if (controls.length() <= 0 || control_index < 0 || control_index >= controls.length()) return null;
		return @controls[control_index];
	}
	nv_form_control@find_next_control(bool next = true, bool wrap = true) const {
		if (controls.length() == 0) return null;
		int index = control_index;
		for (uint i = 0; i < controls.length(); i++) {
			index += (next ? 1 : -1);
			if (index < 0 || index >= controls.length()) {
				if (!wrap) return null;
				index = (index >= controls.length() ? 0 : controls.length() - 1);
			}
			if (@controls[index] != null and !controls[index].hidden)
				return controls[index];
		}
		return null;
	}
	bool create_window(const string &in title, bool change_screen_title = true, bool say_dialog = true, bool silent = false) {
		if (active) {
			error(NV_FORM_ERROR_ALREADY_ACTIVE);
			return false;
		} else if (title.empty()) {
			error(NV_FORM_ERROR_INVALID_OPERATION);
			return false;
		}
		window_title = title;
		get_characters();
		active = true;
		@shortcut = nv_shortcut_manager();
		shortcut.tap_timeout = tap_timeout;
		if (change_screen_title) show_window(window_title);
		if (!silent)
			speak(window_title + (say_dialog ? "  dialog" : ""), false);
		return true;
	}
	bool check_controls(nv_form_control@&out ctrl = void) {
		if (controls.length() <= 0) return false;
		bool result = false;
		for (uint i = 0; i < controls.length(); i += 1) {
			if (controls[i].monitor()) {
				result = true;
				@ctrl = controls[i];
				break;
			}
		}
		return result;
	}
	bool monitor() {
		if (!active) return false;
		if (@nv_utility_form != null) {
			nv_utility_form.monitor();
			nv_form_suggestion_manager@ sug = cast<nv_form_suggestion_manager@>(nv_utility_form);
			if (@sug == null) return true;
		}
		handle_input();
		if (@cancel_control != null and cancel_control.monitor()) return false;
		nv_form_control@ctrl;
		check_controls(ctrl);
		if (@background_callback != null) {
			if (!background_callback(this, null)) return false;
		}
		return true;
	}
	bool handle_input() {
		nv_form_control@ ctrl = current_control;
		nv_form_control@ pctrl = primary_control;
		bool handled = false;
		if (@ctrl != null) {
			if (@nv_utility_form != null) {
				nv_form_suggestion_manager@ sug = cast<nv_form_suggestion_manager@>(nv_utility_form);
				if (@sug != null) {
					if (key_repeating(KEY_DOWN)) handled = sug.handle_key(KEY_DOWN);
					else if (key_repeating(KEY_UP)) handled = sug.handle_key(KEY_UP);
					else if (key_repeating(KEY_PAGEUP)) handled = sug.handle_key(KEY_PAGEUP);
					else if (key_repeating(KEY_PAGEDOWN)) handled = sug.handle_key(KEY_PAGEDOWN);
					else if (key_pressed(KEY_HOME)) handled = sug.handle_key(KEY_HOME);
					else if (key_pressed(KEY_END)) handled = sug.handle_key(KEY_END);
					else if (key_pressed(KEY_RETURN)) handled = sug.handle_key(KEY_RETURN);
					else if (key_pressed(KEY_NUMPAD_ENTER)) handled = sug.handle_key(KEY_NUMPAD_ENTER);
					else if (key_pressed(KEY_TAB)) handled = sug.handle_key(KEY_TAB);
					else if (key_pressed(KEY_ESCAPE)) handled = sug.handle_key(KEY_ESCAPE);
					if (handled) return true;
				}
			}
			handled = ctrl.handle_input();
			if (((keyboard_modifiers & KEYMOD_SHIFT) != 0 && key_pressed(KEY_F10)) || key_pressed(KEY_MENU) || key_pressed(KEY_APPLICATION)) {
				if (@ctrl.context_menu != null) {
					ctrl.context_menu.show();
					return true;
				}
			}
		}
		if (!handled) {
			if (key_repeating(KEY_TAB)) {
				bool next_control = true;
				if ((keyboard_modifiers & KEYMOD_SHIFT) != 0) next_control = false;
				navigate_form(next_control);
			} else if (@cancel_control != null && key_pressed(KEY_ESCAPE)) {
				nv_form_tab_control@ tab = cast<nv_form_tab_control@>(ctrl);
				if (@tab == null || !tab.is_waiting_form) {
					cancel_control.fire();
					handled = true;
				}
			} else if (@pctrl != null && pctrl.type != NV_FORM_CT_KEYBOARD_AREA && (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER))) {
				pctrl.fire();
				handled = true;
			}
		}
		if (handled) return true;
		bool found_shortcut = false;
		int sposition = clamp(control_index + 1, 0, controls.length() - 1);
		for (uint i = sposition; i < controls.length(); i++) {
			if (@controls[i] == null || @controls[i].shortcut == null) continue;
			if (controls[i].check_shortcut()) {
				found_shortcut = true;
				controls[i].shortcut_focus();
				shortcut.consume();
				break;
			}
		}
		if (!found_shortcut) {
			for (uint i = 0; i < controls.length(); i++) {
				nv_form_control@l = controls[i];
				if (@l == null || @l.shortcut == null) continue;
				if (l.check_shortcut()) {
					l.shortcut_focus();
					shortcut.consume();
					break;
				}
			}
		}
		return handled;
	}
	void error(nv_form_errorcode error) {
		errors.insert_last(error);
	}
	nv_form_errorcode get_last_error() const property {
		if (errors.length() <= 0) return NV_FORM_ERROR_NONE;
		return errors[errors.length() - 1];
	}
	bool is_pressed(const string &in control_id) {
		nv_form_control@ctrl = get_control_by_id(control_id);
		if (@ctrl == null || (ctrl.type != NV_FORM_CT_BUTTON && ctrl.type != NV_FORM_CT_LINK)) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		}
		nv_form_button@btn = cast < nv_form_button@ > (ctrl);
		nv_form_link@link = cast < nv_form_link@ > (ctrl);
		if (@btn == null && @link == null) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		} else if (@btn != null) return is_pressed(btn);
		else if (@link != null) return is_pressed(link);
		return false;
	}
	bool is_pressed(nv_form_button@btn) {
		if (@btn.parent != this) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		}
		bool result = btn.pressed;
		if (result) btn.pressed = false;
		return result;
	}
	bool is_pressed(nv_form_link@link) {
		if (@link.parent != this) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		}
		bool result = link.pressed;
		if (result) link.pressed = false;
		return result;
	}
	bool is_checked(const string &in control_id) {
		nv_form_checkbox@box = cast < nv_form_checkbox@ > (get_control_by_id(control_id));
		if (@box == null) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		}
		return is_checked(box);
	}
	bool is_checked(nv_form_checkbox@box) {
		if (@box.parent != this) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		}
		return box.state;
	}
	nv_form_list_item@get_list_focus(const string &in control_id) {
		return get_list_focus(cast < nv_form_list_box@ > (get_control_by_id(control_id)));
	}
	nv_form_list_item@get_list_focus(nv_form_list_box@lst) {
		if (@lst == null or @lst.parent != this) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return null;
		}
		return lst.focused_item;
	}
	nv_form_switch_item@get_switch_focus(const string &in control_id) {
		return get_switch_focus(cast < nv_form_switch@ > (get_control_by_id(control_id)));
	}
	nv_form_switch_item@get_switch_focus(nv_form_switch@lst) {
		if (@lst == null or @lst.parent != this) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return null;
		}
		return lst.focused_item;
	}
	double get_slider_value(const string &in control_id, double def = 0) {
		return get_slider_value(cast < nv_form_slider@ > (get_control_by_id(control_id)), def);
	}
	double get_slider_value(nv_form_slider@slider, double def = 0) {
		if (@slider == null or @slider.parent != this) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return def;
		}
		return slider.value;
	}
	nv_form_button@ add_button(const string &in caption, const string &in id = "", bool primary = false, bool cancel = false, int position = -1, nv_form_control_callback@callback = null) {
		nv_form_button@btn = nv_form_button(this, caption, id);
		bool added = add_control(btn, primary, cancel, position, @callback);
		if (added) return btn;
		return null;
	}
	nv_form_link@ add_link(const string &in caption, const string &in url, const string &in id = "", bool primary = false, bool cancel = false, int position = -1, nv_form_control_callback@callback = null) {
		nv_form_link@link = nv_form_link(this, caption, url, id);
		bool added = add_control(link, primary, cancel, position, @callback);
		if (added) return link;
		return null;
	}
	nv_form_input@ add_input(const string &in caption, const string &in id = "", const string &in default_text = "", const string &in password_mask = "", int max_length = 0, bool read_only = false, bool multiline = false, int position = -1, nv_form_control_callback@callback = null) {
		nv_form_input@inp = nv_form_input(this, caption, id);
		inp.password_mask = password_mask;
		inp.max_length = max_length;
		inp.default_text = default_text;
		inp.read_only = read_only;
		inp.multiline = multiline;
		bool added = add_control(inp, false, false, position, @callback);
		if (added) return inp;
		return null;
	}
	nv_form_spin@ add_spin(const string &in caption, const string &in id = "", const string &in default_text = "", double min = 0, double max = 100, bool read_only = false, double step = 1, double page = 0, int position = -1, nv_form_control_callback@callback = null) {
		nv_form_spin@inp = nv_form_spin(this, caption, id, min, max, step, page);
		inp.default_text = default_text;
		inp.read_only = read_only;
		bool added = add_control(inp, false, false, position, @callback);
		if (added) return inp;
		return null;
	}
	nv_form_checkbox@ add_checkbox(const string &in caption, const string &in id = "", bool selected = false, int position = -1) {
		nv_form_checkbox@checkbox = nv_form_checkbox(this, caption, id, selected);
		bool added = add_control(checkbox, position = position);
		if (added) return checkbox;
		return null;
	}
	nv_form_list_box@ add_list(const string &in caption, const string &in id = "", bool multiselect = false, nv_form_list_item@[] items = {}, int max_items = 0, int position = -1, bool speak_position = false) {
		nv_form_list_box@lst = nv_form_list_box(this, caption, id, multiselect, items, max_items, speak_position);
		bool added = add_control(lst, position = position);
		if (added) return lst;
		return null;
	}
	nv_form_switch@ add_switch(const string &in caption, const string &in id = "", nv_form_switch_item@[] items = {}, int position = -1) {
		nv_form_switch@ lst = nv_form_switch(this, caption, id, items);
		bool added = add_control(lst, position = position);
		if (added) return lst;
		return null;
	}
	nv_form_slider@ add_slider(const string &in caption, const string &in id = "", double min_value = 0, double max_value = 100, double step_size = 1, double initial_value = 0, double page_size = 0, int position = -1, dictionary@ text = null) {
		nv_form_slider slide(this, caption, id, min_value, max_value, step_size, initial_value, page_size, text);
		bool added = add_control(@slide, position = position);
		if (added) return slide;
		return null;
	}
	nv_form_progress_bar@ add_progress_bar(const string &in caption, const string &in id = "", double min = 0, double max = 100, double initial = 0.0, int position = -1) {
		nv_form_progress_bar@bar = nv_form_progress_bar(@this, caption, id, min, max, initial);
		bool added = add_control(@bar, position = position);
		if (added) return bar;
		return null;
	}
	nv_form_table@ add_table(const string &in caption, const string &in id = "", int position = -1, bool speak_position = false) {
		nv_form_table@table = nv_form_table(@this, caption, id, speak_position);
		bool added = add_control(@table, position = position);
		if (added) return table;
		return null;
	}
	nv_form_keyboard_area@ add_keyboard_area(const string &in caption, const string &in id = "", int position = -1) {
		nv_form_keyboard_area area(@this, caption, id);
		bool added = add_control(@area, position = position);
		if (added) return area;
		return null;
	}
	nv_form_treeview@ add_treeview(const string &in caption, const string &in id = "", nv_form_tree_node@[] nodes = {}, int position = -1) {
		nv_form_treeview@tv = nv_form_treeview(this, caption, id);
		tv.nodes = nodes;
		tv.rebuild();
		bool added = add_control(tv, position = position);
		if (added) return tv;
		return null;
	}
	bool add_control(nv_form_control@ctrl, bool primary = false, bool cancel = false, int position = -1, nv_form_control_callback@callback = null) {
		if (!active) {
			error(NV_FORM_ERROR_NO_WINDOW);
			return false;
		}
		if (max_controls > 0 and controls.length() >= max_controls) {
			error(NV_FORM_ERROR_WINDOW_FULL);
			return false;
		}
		if (@ctrl == null) {
			error(NV_FORM_ERROR_INVALID_CONTROL);
			return false;
		}
		if (@callback != null) @ctrl.callback = callback;
		if (position < 0) controls.insert_last(ctrl);
		else controls.insert_at(position, ctrl);
		if (primary) @primary_control = @ctrl;
		if (cancel) @cancel_control = @ctrl;
		return true;
	}
	bool navigate_form(bool next = true, bool quiet = false, bool interrupt_previous_speech = true) {
		nv_form_control@ctrl = find_next_control(next);
		return focus_control(ctrl, quiet, interrupt_previous_speech);
	}
	bool focus_control(nv_form_control@ctrl, bool quiet = false, bool interrupt_previous_speech = true) {
		if (@ctrl == null) return false;
		int index = controls.find_by_ref(ctrl);
		if (index == -1) return false;
		return set_focus(index, quiet, interrupt_previous_speech);
	}
	private bool set_focus(int control_index, bool quiet = false, bool interrupt_previous_speech = true) {
		if (control_index<0 || control_index >= controls.length()) return false;
		nv_form_control@ current = current_control;
		if (@current != null)
			current.event.fire(nv_form_event(current, NV_FORM_EVENT_FOCUS_LOST));
		this.control_index = control_index;
		current_control.event.fire(nv_form_event(this.current_control, NV_FORM_EVENT_FOCUS_GAINED));
		current_control.on_focus_gained_immediate();
		bool result;
		if (!quiet) result = speak_current_control(interrupt_previous_speech);
		else result = true;
		current_control.on_focus_gained();
		return result;
	}
	string get_fixed_type(nv_form_control@ ctrl) {
		if (@ctrl == null) return "";
		string f;
		if (ctrl.custom_type != "") f = ctrl.custom_type;
		else f = get_nv_form_control_type_string(ctrl.type);
		string t = ctrl.fixed_type_last;
		string t2 = ctrl.fixed_type_first;
		if (t != "") f += " " + t;
		if (t2 != "") f.insert(0, t2 + " ");
		return f.trim_whitespace();
	}
	bool speak_current_control(bool interrupt = true) {
		if (control_index == -1) return false;
		nv_form_control@ctrl = controls[control_index];
		if (@ctrl == null) return false;
		string ct = ctrl.str;
		if (ct != "" && !speak_control_attributes_separately) return speak(ct, interrupt);
		else if (ct != "" && speak_control_attributes_separately) {
			speak(ct, interrupt);
			speak(ctrl.get_control_info(), false);
			return true;
		}
		return false;
	}
	bool search(nv_form_control@ ctrl, const string& in text, int dir = 1, bool silent = false) {
		nv_form_input@ ctrl_input = cast < nv_form_input@ > (ctrl);
		nv_form_list_box@ ctrl_list = cast < nv_form_list_box@ > (ctrl);
		nv_form_treeview@ ctrl_tree = cast < nv_form_treeview@ > (ctrl);
		if (@ctrl_input != null) return ctrl_input.search(text, dir, silent);
		else if (@ctrl_list != null) return ctrl_list.search(text, dir, silent);
		else if (@ctrl_tree != null) return ctrl_tree.search(text, dir, silent);
		return false;
	}
	nv_utility_form@ nv_utility_form = null;
	dictionary nv_utility_form_data;
	bool get_is_first_control() const property {
		int x = control_index;
		if (x <= 0) return true;
		nv_form_control@ c = find_next_control(false, false);
		return @c == null;
	}
	bool get_is_last_control() const property {
		int x = control_index;
		if (x < 0) return false;
		if (x >= controls.length() - 1) return true;
		nv_form_control@ c = find_next_control(true, false);
		return @c == null;
	}
	uint get_controls_count() const property {
		uint total = 0;
		for (uint i = 0; i < controls.length(); i++) {
			if (@controls[i] == null || controls[i].hidden) continue;
			total ++;
		}
		return total;
	}
}
