// Other miscellaneous functions and classes.
shared int nv_string_contains(const string &in str, const string &in search, int occurance = 1) {
	uint c = 0;
	int pos = -1;
	while (c < occurance) {
		pos = str.find_first(search, pos + 1);
		if (pos > -1)
			c++;
		else
			break;
	}
	return c == occurance ? pos : -1;
}
// Wrapper functions for keyboard echo changing.
shared int nvform_change_keyboard_echo(int keyboard_echo, int dir = 1) {
	keyboard_echo += dir;
	if (keyboard_echo < TEXTFLAG_ENTRY_NONE) keyboard_echo = TEXTFLAG_ENTRY_CHARACTERS_WORDS;
	else if (keyboard_echo > TEXTFLAG_ENTRY_CHARACTERS_WORDS) keyboard_echo = TEXTFLAG_ENTRY_NONE;
	return keyboard_echo;
}
shared string nvform_keyboard_echo_string(int keyboard_echo) {
	if (keyboard_echo == TEXTFLAG_ENTRY_CHARACTERS) return "characters";
	else if (keyboard_echo == TEXTFLAG_ENTRY_WORDS) return "words";
	else if (keyboard_echo == TEXTFLAG_ENTRY_CHARACTERS_WORDS) return "characters and words";
	else return "none";
}
