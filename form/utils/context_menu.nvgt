class nv_form_context_menu_item: nv_form_list_item {
	nv_form_control_callback@ callback;
	nv_form_context_menu_item(const string &in text, const string &in id, nv_form_control_callback@ callback) {
		super(text, id);
		@this.callback = @callback;
	}
}
class nv_form_context_menu : nv_utility_form {
	nv_form@ parent_form;
	nv_form_control@ owner_control;
	nv_form_context_menu_item@[] items;
	nv_form f;
	nv_form_list_box@ list;
	string title;
	bool change_screen_title, say_dialog;
	nv_form_context_menu(nv_form@ parent_form, nv_form_control@ owner_control, const string &in title = "Context Menu", bool change_screen_title = false, bool say_dialog = true) {
		@this.parent_form = @parent_form;
		@this.owner_control = @owner_control;
		this.title = title;
		this.change_screen_title = change_screen_title;
		this.say_dialog = say_dialog;
	}
	void add_item(const string &in text, nv_form_control_callback@ callback) {
		items.insert_last(nv_form_context_menu_item(text, text, @callback));
	}
	void add_item(const string &in text, const string &in id, nv_form_control_callback@ callback) {
		items.insert_last(nv_form_context_menu_item(text, id, @callback));
	}
	void show() {
		if (items.length() == 0 || f.active) return;
		f.create_window(title, change_screen_title, say_dialog);
		@list = f.add_list("Actions", "actions", false);
		for (uint i = 0; i < items.length(); i++) {
			list.add(items[i].text, items[i].id);
		}
		list.list_position = 0;
		nv_form_button@ cancel_btn = f.add_button("Cancel", "cancel", false, true);
		@cancel_btn.shortcut = nv_shortcut(KEY_C, alt = true);
		cancel_btn.hidden = true;
		@f.background_callback = parent_form.background_callback;
		f.focus_control(list, false, false);
		@parent_form.nv_utility_form = this;
	}
	void monitor() {
		if (!f.monitor()) {
			close();
			return;
		}
		if (f.is_pressed("cancel")) {
			close();
		}
		else if (list.pressed) {
			list.pressed = false;
			int idx = list.list_position;
			if (idx >= 0 && idx < items.length()) {
				nv_form_control_callback@ cb = items[idx].callback;
				close(true);
				if (@cb != null) cb(owner_control);
			}
		}
	}
	private void close(bool silent = false) {
		@parent_form.nv_utility_form = null;
		f.reset();
		parent_form.focus_control(owner_control, silent);
	}
}
