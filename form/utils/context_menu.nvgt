class nv_form_context_menu_item: nv_form_list_item {
	nv_form_context_menu_callback@ callback;
	nv_form_context_menu_item(const string &in text, const string &in id, nv_form_context_menu_callback@ callback) {
		super(text, id);
		@this.callback = @callback;
	}
}
class nv_form_context_menu : nv_utility_form {
	nv_form@ parent;
	nv_form_control@ ctrl;
	nv_form_context_menu_item@[] items;
	protected nv_form f;
	nv_form_list_box@ list;
	string title;
	bool change_screen_title, say_dialog;
	nv_form_context_menu_callback@ default_callback;
	nv_form_context_menu(nv_form@ parent, nv_form_control@ ctrl, const string &in title = "Context Menu", bool change_screen_title = false, bool say_dialog = true, nv_form_context_menu_callback@ callback = null) {
		@this.parent = @parent;
		@this.ctrl = @ctrl;
		this.title = title;
		this.change_screen_title = change_screen_title;
		this.say_dialog = say_dialog;
		@default_callback = @callback;
	}
	void add_item(const string &in text, nv_form_context_menu_callback@ callback) {
		add_item(text, text, @callback);
	}
	void add_item(const string &in text) {
		add_item(text, default_callback);
	}
	void add_item(const string &in text, const string &in id, nv_form_context_menu_callback@ callback) {
		items.insert_last(nv_form_context_menu_item(text, id, @callback));
	}
	void add_item(const string &in text, const string &in id) {
		add_item(text, id, default_callback);
	}
	void show() {
		if (items.length() == 0 || f.active) return;
		f.create_window(title, change_screen_title, say_dialog);
		@list = f.add_list("Actions", "actions", false);
		for (uint i = 0; i < items.length(); i++) {
			list.add(items[i].text, items[i].id);
		}
		nv_form_button@ ok_btn = f.add_button("Ok", "ok", true);
		ok_btn.hidden = true;
		nv_form_button@ cancel_btn = f.add_button("Cancel", "cancel", false, true);
		@cancel_btn.shortcut = nv_shortcut(KEY_C, alt = true);
		cancel_btn.hidden = true;
		@f.background_callback = parent.background_callback;
		f.focus_control(list, false, false);
		@parent.nv_utility_form = this;
	}
	void monitor() {
		if (!f.monitor()) {
			close();
			return;
		}
		if (f.is_pressed("cancel")) {
			close();
			return;
		} else if (f.is_pressed("ok")) {
			int idx = list.list_position;
			if (idx >= 0 && idx < items.length()) {
				nv_form_context_menu_callback@ cb = items[idx].callback;
				close(true);
				if (@cb != null) cb(this);
			}
		}
	}
	private void close(bool silent = false) {
		@parent.nv_utility_form = null;
		f.reset();
		parent.focus_control(ctrl, silent);
	}
}
