class nv_form_event_dispatcher {
	nv_form_event_handler@[] handlers;
	nv_form_event_handler@ v {
		get const {
			return handlers.length() > 0 ? handlers[0] : null;
		}
		set {
			handlers.resize(0);
			if (@value != null) handlers.insert_last(value);
		}
	}
	bool add(nv_form_event_handler@ cb) {
		if (@cb == null || handlers.find_by_ref(cb) > -1) return false;
		handlers.insert_last(cb);
		return true;
	}
	bool add(nv_form_event_handler@[] cbs) {
		if (cbs.length() < 1) return false;
		uint c = 0;
		for (uint i = 0; i < cbs.length(); i++) {
			if (add(cbs[i])) c++;
		}
		return c != 0;
	}
	bool remove(nv_form_event_handler@ cb) {
		if (@cb == null) return false;
		int x = handlers.find_by_ref(cb);
		if (x < 0) return false;
		handlers.remove_at(x);
		return true;
	}
	void clear() {
		handlers.resize(0);
	}
	uint get_count() const property {
		return handlers.length();
	}
	void fire(nv_form_event@ event) {
		for (uint i = 0; i < count; i++) {
			if (@handlers[i] == null) continue;
			handlers[i](event);
		}
	}
}
class nv_form_event {
	int type;
	nv_form_control@ ctrl;
	nv_form_event(nv_form_control@ ctrl, int type) {
		@this.ctrl = @ctrl;
		this.type = type;
	}
}
enum nv_form_event_type {
	NV_FORM_EVENT_NONE = 0,
	NV_FORM_EVENT_FOCUS_GAINED,
	NV_FORM_EVENT_FOCUS_LOST,
	NV_FORM_EVENT_CHECKBOX_TOGGLED,
	NV_FORM_EVENT_SLIDER_CHANGED,
	NV_FORM_EVENT_SWITCH_CHANGED,
	NV_FORM_EVENT_INPUT,
	NV_FORM_EVENT_LIST,
	NV_FORM_EVENT_TREEVIEW
}
